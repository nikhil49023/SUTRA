# SUTRA Simulation & GUI Environment with noVNC Web Display
FROM osrf/ros:jazzy-desktop-full

ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:1
ENV VNC_PORT=5900
ENV NOVNC_PORT=8080

# 1. Install desktop tools, virtual X server, VNC server & noVNC
RUN apt-get update && apt-get install -y \
    xvfb \
    x11vnc \
    fluxbox \
    novnc \
    websockify \
    net-tools \
    curl \
    git \
    wget \
    python3-pip \
    python3-colcon-common-extensions \
    ffmpeg \
    libsm6 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*

# 2. Setup workspace
WORKDIR /sutra_ws

# 3. Copy requirements and install Python dependencies
COPY requirements.txt /sutra_ws/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt --break-system-packages || true

# 4. Copy workspace sources
COPY . /sutra_ws

# 5. Build colcon workspace
SHELL ["/bin/bash", "-c"]
RUN source /opt/ros/jazzy/setup.bash && colcon build --symlink-install || true

# 6. Expose ports: 8080 (noVNC web GUI), 5900 (RFB VNC), 9090 (ROS2 GCS Bridge)
EXPOSE 8080 5900 9090

# 7. Create startup script for virtual display and web streaming
RUN echo '#!/bin/bash\n\
set -e\n\
source /opt/ros/jazzy/setup.bash\n\
if [ -f /sutra_ws/install/setup.bash ]; then source /sutra_ws/install/setup.bash; fi\n\
\n\
# Start Xvfb virtual framebuffer\n\
Xvfb :1 -screen 0 1920x1080x24 &\n\
sleep 1\n\
\n\
# Start window manager\n\
fluxbox &\n\
\n\
# Start x11vnc\n\
x11vnc -display :1 -nopw -listen 0.0.0.0 -xkb -ncache 10 -ncache_cr -forever &\n\
sleep 1\n\
\n\
# Start websockify / noVNC web proxy\n\
websockify --web /usr/share/novnc/ 8080 localhost:5900 &\n\
echo "=== noVNC Web GUI ready at http://localhost:8080/vnc.html ==="\n\
\n\
# Execute user command\n\
exec "$@"\n' > /entrypoint_novnc.sh && chmod +x /entrypoint_novnc.sh

ENTRYPOINT ["/entrypoint_novnc.sh"]
CMD ["bash"]
