# SUTRA Subsystem A - ROS 2 Jazzy + Gazebo Sim 8 + noVNC Web Engine + NVIDIA GPU Acceleration
FROM osrf/ros:jazzy-desktop-full

ENV DEBIAN_FRONTEND=noninteractive

# NVIDIA GPU Environment Variables
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=all,utility,graphics,compute,display

# Install system utilities, Xvfb, fluxbox, x11vnc, novnc, OpenGL drivers and Gazebo Sim 8 dependencies
RUN apt-get update && apt-get install -y \
    xvfb \
    fluxbox \
    x11vnc \
    novnc \
    websockify \
    python3-pip \
    python3-colcon-common-extensions \
    curl \
    git \
    wget \
    ffmpeg \
    libsm6 \
    libxext6 \
    libgl1 \
    libglx-mesa0 \
    libgl1-mesa-dri \
    mesa-utils \
    ros-jazzy-actuator-msgs \
    ros-jazzy-ros-gz \
    ros-jazzy-ros-gz-bridge \
    ros-jazzy-ros-gz-sim \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /sutra_ws

# Copy requirements and install Python ML & GNC dependencies
COPY requirements.txt /tmp/sutra_requirements.txt
RUN pip install --no-cache-dir -r /tmp/sutra_requirements.txt --break-system-packages || true

# Copy the ROS 2 workspace source (only the colcon workspace, no stray research dirs)
COPY sutra_ws /sutra_ws

# Build ROS 2 workspace
SHELL ["/bin/bash", "-c"]
RUN source /opt/ros/jazzy/setup.bash && colcon build --symlink-install

# Copy entrypoint script
COPY docker/entrypoint_novnc.sh /entrypoint_novnc.sh
RUN chmod +x /entrypoint_novnc.sh

EXPOSE 8080 5900 9090

ENTRYPOINT ["/entrypoint_novnc.sh"]
