  <version>1.0.0</version>
  <description>Subsystem B &amp; E: Gazebo SITL Simulation &amp; Digital Twin World Models</description>
  <maintainer email="nikhil@sutra.ai">Nikhil</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
