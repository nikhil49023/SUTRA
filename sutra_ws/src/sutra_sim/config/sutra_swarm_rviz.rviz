        uav_alpha_label: true
        uav_alpha_orca_bubble: true
        uav_beta_label: true
        uav_beta_orca_bubble: true
        uav_delta_label: true
        uav_delta_orca_bubble: true
        uav_epsilon_label: true
        uav_epsilon_orca_bubble: true
