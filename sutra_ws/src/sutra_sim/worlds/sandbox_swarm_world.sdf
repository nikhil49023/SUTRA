<?xml version="1.0" ?>
<!--
  PROJECT SUTRA — 5-Drone Pegasus Swarm Sandbox World
  ====================================================
  Author: Tech Lead Nikhil (Subsystem A + B Lead)
  Location: sutra_ws/src/sutra_sim/worlds/sandbox_swarm_world.sdf

  SDF 1.8 world with 5 X3 UAVs equipped with:
    - 360° GPU LiDAR Sensor Puck (Top Mounted)
    - Edge AI TPU & Companion Computer Enclosure (Google Coral / Jetson Orin)
    - Dual Optical RGB & LWIR Thermal Gimbal Cameras (Nose Mounted)
    - GNSS / GPS Antenna Mast & Compass Puck
    - Dual 802.11s Mesh Dipole Antennas (Swarm Comms)
    - High-Capacity LiPo Battery Underbelly Pack
-->
<sdf version="1.8">
  <world name="sandbox_swarm_world">

    <physics name="500hz" type="dart">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-air-pressure-system"
            name="gz::sim::systems::AirPressure" />
    <plugin filename="gz-sim-magnetometer-system"
            name="gz::sim::systems::Magnetometer" />
    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat" />
    <plugin filename="gz-sim-wind-effects-system"
            name="gz::sim::systems::WindEffects">
      <horizontal>
        <magnitude>0.0</magnitude>
        <direction>1.0 0.0 0.0</direction>
      </horizontal>
      <vertical>
        <magnitude>0.0</magnitude>
      </vertical>
    </plugin>

    <!-- ── Sun & Ambient Lighting ──────────────────────────────────────── -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 40 0 0 0</pose>
      <diffuse>0.95 0.93 0.90 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <direction>-0.3 0.4 -0.85</direction>
    </light>

    <!-- ── Ground Plane — 100m × 100m Desert Sand / Terrain ────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.50 0.46 0.38 1</ambient>
            <diffuse>0.62 0.58 0.48 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Arena Boundary Walls — 4m high ──────────────────────────────── -->
    <model name="wall_north"><static>true</static><pose>0 40 2.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>80 0.5 4.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>80 0.5 4.0</size></box></geometry>
          <material><ambient>0.30 0.28 0.26 1</ambient><diffuse>0.35 0.33 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south"><static>true</static><pose>0 -40 2.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>80 0.5 4.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>80 0.5 4.0</size></box></geometry>
          <material><ambient>0.30 0.28 0.26 1</ambient><diffuse>0.35 0.33 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east"><static>true</static><pose>40 0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 80 4.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 80 4.0</size></box></geometry>
          <material><ambient>0.30 0.28 0.26 1</ambient><diffuse>0.35 0.33 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west"><static>true</static><pose>-40 0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 80 4.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 80 4.0</size></box></geometry>
          <material><ambient>0.30 0.28 0.26 1</ambient><diffuse>0.35 0.33 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Origin Helipad — Glowing yellow disc ─────────────────────────── -->
    <model name="home_helipad"><static>true</static><pose>0 0 0.015 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>2.0</radius><length>0.03</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.8 0.0 1</ambient>
            <diffuse>0.9 0.8 0.0 1</diffuse>
            <emissive>0.5 0.45 0.0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════════
         UAV_ALPHA — Cyan Lead Drone
    ════════════════════════════════════════════════════════════════════════ -->
    <model name="uav_alpha">
      <pose>0 0 0.2 0 0 0</pose>
      <static>false</static>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>1.5</mass><inertia><ixx>0.03475</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.07000</iyy><iyz>0</iyz><izz>0.09770</izz></inertia></inertial>
        <collision name="col"><geometry><box><size>0.47 0.47 0.11</size></box></geometry></collision>
        <visual name="body"><geometry><mesh><scale>1.5 1.5 1.5</scale><uri>model://x3_uav/meshes/x3.dae</uri></mesh></geometry></visual>
        <visual name="r_fl"><pose>0.20 -0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>0.0 0.8 1.0 1</ambient><diffuse>0.0 0.8 1.0 1</diffuse></material></visual>
        <visual name="r_rr"><pose>-0.20 0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>0.0 0.8 1.0 1</ambient><diffuse>0.0 0.8 1.0 1</diffuse></material></visual>
        <visual name="r_fr"><pose>0.20 0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>1.0 0.2 0.2 1</ambient><diffuse>1.0 0.2 0.2 1</diffuse></material></visual>
        <visual name="r_rl"><pose>-0.20 -0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>1.0 0.2 0.2 1</ambient><diffuse>1.0 0.2 0.2 1</diffuse></material></visual>

        <!-- 🛰️ PHYSICAL HARDWARE PAYLOAD STACK -->
        <visual name="lidar_base"><pose>0 0 0.055 0 0 0</pose><geometry><cylinder><radius>0.042</radius><length>0.022</length></cylinder></geometry><material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.22 0.22 0.26 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual>
        <visual name="lidar_ring"><pose>0 0 0.068 0 0 0</pose><geometry><cylinder><radius>0.039</radius><length>0.016</length></cylinder></geometry><material><ambient>0.0 0.7 0.9 1</ambient><diffuse>0.0 0.85 1.0 1</diffuse><emissive>0.0 0.45 0.85 1</emissive></material></visual>
        <visual name="lidar_cap"><pose>0 0 0.078 0 0 0</pose><geometry><cylinder><radius>0.041</radius><length>0.008</length></cylinder></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
        <visual name="edge_tpu_case"><pose>-0.05 0 0.038 0 0 0</pose><geometry><box><size>0.085 0.065 0.022</size></box></geometry><material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material></visual>
        <visual name="edge_tpu_heatsink"><pose>-0.05 0 0.051 0 0 0</pose><geometry><box><size>0.075 0.055 0.006</size></box></geometry><material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse><specular>0.9 0.9 0.9 1</specular></material></visual>
        <visual name="edge_tpu_led"><pose>-0.015 0.024 0.052 0 0 0</pose><geometry><box><size>0.008 0.008 0.004</size></box></geometry><material><ambient>0.0 1.0 0.3 1</ambient><diffuse>0.0 1.0 0.3 1</diffuse><emissive>0.0 1.0 0.3 1</emissive></material></visual>
        <visual name="gimbal_bracket"><pose>0.135 0 -0.028 0 0.15 0</pose><geometry><box><size>0.035 0.055 0.030</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name="camera_rgb_lens"><pose>0.155 -0.015 -0.030 0 1.5708 0</pose><geometry><cylinder><radius>0.010</radius><length>0.014</length></cylinder></geometry><material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.6 0.9 1</diffuse><emissive>0.0 0.3 0.6 1</emissive></material></visual>
        <visual name="camera_thermal_lens"><pose>0.155 0.015 -0.030 0 1.5708 0</pose><geometry><cylinder><radius>0.012</radius><length>0.014</length></cylinder></geometry><material><ambient>0.8 0.35 0.0 1</ambient><diffuse>0.9 0.45 0.0 1</diffuse><emissive>0.7 0.25 0.0 1</emissive></material></visual>
        <visual name="gps_mast"><pose>-0.10 -0.08 0.065 0 0 0</pose><geometry><cylinder><radius>0.0035</radius><length>0.08</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name="gps_puck"><pose>-0.10 -0.08 0.108 0 0 0</pose><geometry><cylinder><radius>0.022</radius><length>0.010</length></cylinder></geometry><material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.25 0.25 0.30 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
        <visual name="mesh_ant_l"><pose>-0.14 0.11 0.045 0.25 -0.2 0</pose><geometry><cylinder><radius>0.0032</radius><length>0.075</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <visual name="mesh_ant_r"><pose>-0.14 -0.11 0.045 -0.25 -0.2 0</pose><geometry><cylinder><radius>0.0032</radius><length>0.075</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <visual name="battery_pack"><pose>0 0 -0.028 0 0 0</pose><geometry><box><size>0.13 0.048 0.034</size></box></geometry><material><ambient>0.8 0.65 0.0 1</ambient><diffuse>0.9 0.75 0.0 1</diffuse></material></visual>

        <!-- SENSORS -->
        <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>250</update_rate><topic>/uav_alpha/imu</topic></sensor>
        <sensor name="air_pressure" type="air_pressure"><always_on>1</always_on><update_rate>50</update_rate><topic>/uav_alpha/air_pressure</topic><air_pressure><reference_altitude>0.0</reference_altitude><pressure><noise type="gaussian"><mean>0.0</mean><stddev>1.2</stddev></noise></pressure></air_pressure></sensor>
        <sensor name="magnetometer" type="magnetometer"><always_on>1</always_on><update_rate>50</update_rate><topic>/uav_alpha/magnetometer</topic></sensor>
        <sensor name="navsat" type="navsat"><always_on>1</always_on><update_rate>10</update_rate><topic>/uav_alpha/navsat</topic></sensor>
        <sensor name="lidar" type="gpu_lidar"><pose>0 0 0.1 0 0 0</pose><topic>/uav_alpha/lidar/points</topic><update_rate>10</update_rate><ray><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal><vertical><samples>32</samples><resolution>1</resolution><min_angle>-0.436332</min_angle><max_angle>0.261799</max_angle></vertical></scan><range><min>0.1</min><max>50.0</max></range></ray><always_on>1</always_on></sensor>
        <sensor name="rangefinder" type="gpu_lidar"><pose>0 0 -0.04 0 1.5707963 0</pose><topic>/uav_alpha/rangefinder/distance</topic><update_rate>50</update_rate><ray><scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal><vertical><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan><range><min>0.05</min><max>40.0</max></range></ray><always_on>1</always_on></sensor>
        <sensor name="cam" type="camera"><pose>0.15 0 0 0 0 0</pose><topic>/uav_alpha/camera/image_raw</topic><update_rate>30</update_rate><camera><horizontal_fov>1.3962634</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>0.1</near><far>100</far></clip></camera><always_on>1</always_on></sensor>
        <sensor name="thermal_cam" type="thermal"><pose>0.15 0 -0.03 0 0 0</pose><topic>/uav_alpha/thermal_camera/image_raw</topic><update_rate>30</update_rate><camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>L8</format></image></camera><always_on>1</always_on></sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"><link_name>base_link</link_name><topic>/uav_alpha/gazebo/command/twist</topic><initial_linear>0 0 0</initial_linear><initial_angular>0 0 0</initial_angular></plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions><odom_publish_frequency>50</odom_publish_frequency><odom_frame>world</odom_frame><robot_base_frame>base_link</robot_base_frame></plugin>
    </model>

    <!-- ════════════════════════════════════════════════════════════════════
         UAV_BETA — Orange Relay Drone
    ════════════════════════════════════════════════════════════════════════ -->
    <model name="uav_beta">
      <pose>8 0 0.2 0 0 0</pose>
      <static>false</static>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>1.5</mass><inertia><ixx>0.03475</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.07000</iyy><iyz>0</iyz><izz>0.09770</izz></inertia></inertial>
        <collision name="col"><geometry><box><size>0.47 0.47 0.11</size></box></geometry></collision>
        <visual name="body"><geometry><mesh><scale>1.5 1.5 1.5</scale><uri>model://x3_uav/meshes/x3.dae</uri></mesh></geometry></visual>
        <visual name="r_fl"><pose>0.20 -0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material></visual>
        <visual name="r_rr"><pose>-0.20 0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material></visual>
        <visual name="r_fr"><pose>0.20 0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>1.0 0.2 0.2 1</ambient><diffuse>1.0 0.2 0.2 1</diffuse></material></visual>
        <visual name="r_rl"><pose>-0.20 -0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>1.0 0.2 0.2 1</ambient><diffuse>1.0 0.2 0.2 1</diffuse></material></visual>

        <!-- 🛰️ PHYSICAL HARDWARE PAYLOAD STACK -->
        <visual name="lidar_base"><pose>0 0 0.055 0 0 0</pose><geometry><cylinder><radius>0.042</radius><length>0.022</length></cylinder></geometry><material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.22 0.22 0.26 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual>
        <visual name="lidar_ring"><pose>0 0 0.068 0 0 0</pose><geometry><cylinder><radius>0.039</radius><length>0.016</length></cylinder></geometry><material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.6 0.0 1</diffuse><emissive>0.8 0.4 0.0 1</emissive></material></visual>
        <visual name="lidar_cap"><pose>0 0 0.078 0 0 0</pose><geometry><cylinder><radius>0.041</radius><length>0.008</length></cylinder></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
        <visual name="edge_tpu_case"><pose>-0.05 0 0.038 0 0 0</pose><geometry><box><size>0.085 0.065 0.022</size></box></geometry><material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material></visual>
        <visual name="edge_tpu_heatsink"><pose>-0.05 0 0.051 0 0 0</pose><geometry><box><size>0.075 0.055 0.006</size></box></geometry><material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse><specular>0.9 0.9 0.9 1</specular></material></visual>
        <visual name="edge_tpu_led"><pose>-0.015 0.024 0.052 0 0 0</pose><geometry><box><size>0.008 0.008 0.004</size></box></geometry><material><ambient>0.0 1.0 0.3 1</ambient><diffuse>0.0 1.0 0.3 1</diffuse><emissive>0.0 1.0 0.3 1</emissive></material></visual>
        <visual name="gimbal_bracket"><pose>0.135 0 -0.028 0 0.15 0</pose><geometry><box><size>0.035 0.055 0.030</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name="camera_rgb_lens"><pose>0.155 -0.015 -0.030 0 1.5708 0</pose><geometry><cylinder><radius>0.010</radius><length>0.014</length></cylinder></geometry><material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.6 0.9 1</diffuse><emissive>0.0 0.3 0.6 1</emissive></material></visual>
        <visual name="camera_thermal_lens"><pose>0.155 0.015 -0.030 0 1.5708 0</pose><geometry><cylinder><radius>0.012</radius><length>0.014</length></cylinder></geometry><material><ambient>0.8 0.35 0.0 1</ambient><diffuse>0.9 0.45 0.0 1</diffuse><emissive>0.7 0.25 0.0 1</emissive></material></visual>
        <visual name="gps_mast"><pose>-0.10 -0.08 0.065 0 0 0</pose><geometry><cylinder><radius>0.0035</radius><length>0.08</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name="gps_puck"><pose>-0.10 -0.08 0.108 0 0 0</pose><geometry><cylinder><radius>0.022</radius><length>0.010</length></cylinder></geometry><material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.25 0.25 0.30 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
        <visual name="mesh_ant_l"><pose>-0.14 0.11 0.045 0.25 -0.2 0</pose><geometry><cylinder><radius>0.0032</radius><length>0.075</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <visual name="mesh_ant_r"><pose>-0.14 -0.11 0.045 -0.25 -0.2 0</pose><geometry><cylinder><radius>0.0032</radius><length>0.075</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <visual name="battery_pack"><pose>0 0 -0.028 0 0 0</pose><geometry><box><size>0.13 0.048 0.034</size></box></geometry><material><ambient>0.8 0.65 0.0 1</ambient><diffuse>0.9 0.75 0.0 1</diffuse></material></visual>

        <!-- SENSORS -->
        <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>250</update_rate><topic>/uav_beta/imu</topic></sensor>
        <sensor name="air_pressure" type="air_pressure"><always_on>1</always_on><update_rate>50</update_rate><topic>/uav_beta/air_pressure</topic><air_pressure><reference_altitude>0.0</reference_altitude><pressure><noise type="gaussian"><mean>0.0</mean><stddev>1.2</stddev></noise></pressure></air_pressure></sensor>
        <sensor name="magnetometer" type="magnetometer"><always_on>1</always_on><update_rate>50</update_rate><topic>/uav_beta/magnetometer</topic></sensor>
        <sensor name="navsat" type="navsat"><always_on>1</always_on><update_rate>10</update_rate><topic>/uav_beta/navsat</topic></sensor>
