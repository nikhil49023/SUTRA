<?xml version="1.0" ?>
<!--
  Project SUTRA — 5-Drone Sandbox Swarm World
  =============================================
  Open 80m × 80m flat sandbox arena.
  NO interior obstacles — clean airspace for ORCA avoidance demonstration.
  5 X3 UAVs: alpha, beta, gamma, delta, epsilon.
  Perimeter walls 4m tall at ±40m on X and Y.
  Physics: DART 1ms, RTF 1.0
-->
<sdf version="1.8">
  <world name="sandbox_swarm_world">

    <!-- ── Physics ─────────────────────────────────────────────────────── -->
    <gravity>0 0 -9.80665</gravity>
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ── Scene ───────────────────────────────────────────────────────── -->
    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.55 0.65 0.85 1.0</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>

    <!-- ── Required Plugins ────────────────────────────────────────────── -->
    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"               name="gz::sim::systems::Imu"/>

    <!-- ── Sun ─────────────────────────────────────────────────────────── -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.95 0.95 0.92 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ── Ground Plane — Grey Concrete ────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.45 0.42 0.40 1</ambient>
            <diffuse>0.50 0.48 0.45 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Perimeter Walls — 4m tall, 0.5m thick, at ±40m ─────────────── -->
    <model name="wall_north"><static>true</static><pose>0 40 2.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>80 0.5 4.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>80 0.5 4.0</size></box></geometry>
          <material><ambient>0.30 0.28 0.26 1</ambient><diffuse>0.35 0.33 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south"><static>true</static><pose>0 -40 2.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>80 0.5 4.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>80 0.5 4.0</size></box></geometry>
          <material><ambient>0.30 0.28 0.26 1</ambient><diffuse>0.35 0.33 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east"><static>true</static><pose>40 0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 80 4.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 80 4.0</size></box></geometry>
          <material><ambient>0.30 0.28 0.26 1</ambient><diffuse>0.35 0.33 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west"><static>true</static><pose>-40 0 2.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.5 80 4.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.5 80 4.0</size></box></geometry>
          <material><ambient>0.30 0.28 0.26 1</ambient><diffuse>0.35 0.33 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Origin Helipad — Glowing yellow disc ─────────────────────────── -->
    <model name="home_helipad"><static>true</static><pose>0 0 0.015 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>2.0</radius><length>0.03</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.8 0.0 1</ambient>
            <diffuse>0.9 0.8 0.0 1</diffuse>
            <emissive>0.5 0.45 0.0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════════
         UAV_ALPHA — Cyan rotors — spawns at (0, 0, 0.2)
    ════════════════════════════════════════════════════════════════════════ -->
    <model name="uav_alpha">
      <pose>0 0 0.2 0 0 0</pose>
      <static>false</static>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>1.5</mass><inertia><ixx>0.03475</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.07000</iyy><iyz>0</iyz><izz>0.09770</izz></inertia></inertial>
        <collision name="col"><geometry><box><size>0.47 0.47 0.11</size></box></geometry></collision>
        <visual name="body"><geometry><mesh><scale>1.5 1.5 1.5</scale><uri>model://x3_uav/meshes/x3.dae</uri></mesh></geometry></visual>
        <visual name="r_fl"><pose>0.20 -0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>0.0 0.8 1.0 1</ambient><diffuse>0.0 0.8 1.0 1</diffuse></material></visual>
        <visual name="r_rr"><pose>-0.20 0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>0.0 0.8 1.0 1</ambient><diffuse>0.0 0.8 1.0 1</diffuse></material></visual>
        <visual name="r_fr"><pose>0.20 0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>1.0 0.2 0.2 1</ambient><diffuse>1.0 0.2 0.2 1</diffuse></material></visual>
        <visual name="r_rl"><pose>-0.20 -0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>1.0 0.2 0.2 1</ambient><diffuse>1.0 0.2 0.2 1</diffuse></material></visual>
        <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>200</update_rate><topic>/uav_alpha/imu</topic></sensor>
        <sensor name="lidar" type="gpu_lidar"><pose>0 0 0.1 0 0 0</pose><topic>/uav_alpha/lidar/points</topic><update_rate>10</update_rate><ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal><vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.261799</min_angle><max_angle>0.261799</max_angle></vertical></scan><range><min>0.1</min><max>30.0</max></range></ray><always_on>1</always_on></sensor>
        <sensor name="cam" type="camera"><pose>0.15 0 0 0 0 0</pose><topic>/uav_alpha/camera/image_raw</topic><update_rate>30</update_rate><camera><horizontal_fov>1.3962634</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>0.1</near><far>100</far></clip></camera><always_on>1</always_on></sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"><link_name>base_link</link_name><topic>/uav_alpha/gazebo/command/twist</topic><initial_linear>0 0 0</initial_linear><initial_angular>0 0 0</initial_angular></plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions><odom_publish_frequency>50</odom_publish_frequency><odom_frame>world</odom_frame><robot_base_frame>base_link</robot_base_frame></plugin>
    </model>

    <!-- ════════════════════════════════════════════════════════════════════
         UAV_BETA — Orange rotors — spawns at (8, 0, 0.2)
    ════════════════════════════════════════════════════════════════════════ -->
    <model name="uav_beta">
      <pose>8 0 0.2 0 0 0</pose>
      <static>false</static>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>1.5</mass><inertia><ixx>0.03475</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.07000</iyy><iyz>0</iyz><izz>0.09770</izz></inertia></inertial>
        <collision name="col"><geometry><box><size>0.47 0.47 0.11</size></box></geometry></collision>
        <visual name="body"><geometry><mesh><scale>1.5 1.5 1.5</scale><uri>model://x3_uav/meshes/x3.dae</uri></mesh></geometry></visual>
        <visual name="r_fl"><pose>0.20 -0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material></visual>
        <visual name="r_rr"><pose>-0.20 0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material></visual>
        <visual name="r_fr"><pose>0.20 0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>1.0 0.2 0.2 1</ambient><diffuse>1.0 0.2 0.2 1</diffuse></material></visual>
        <visual name="r_rl"><pose>-0.20 -0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>1.0 0.2 0.2 1</ambient><diffuse>1.0 0.2 0.2 1</diffuse></material></visual>
        <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>200</update_rate><topic>/uav_beta/imu</topic></sensor>
        <sensor name="lidar" type="gpu_lidar"><pose>0 0 0.1 0 0 0</pose><topic>/uav_beta/lidar/points</topic><update_rate>10</update_rate><ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal><vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.261799</min_angle><max_angle>0.261799</max_angle></vertical></scan><range><min>0.1</min><max>30.0</max></range></ray><always_on>1</always_on></sensor>
        <sensor name="cam" type="camera"><pose>0.15 0 0 0 0 0</pose><topic>/uav_beta/camera/image_raw</topic><update_rate>30</update_rate><camera><horizontal_fov>1.3962634</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>0.1</near><far>100</far></clip></camera><always_on>1</always_on></sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"><link_name>base_link</link_name><topic>/uav_beta/gazebo/command/twist</topic><initial_linear>0 0 0</initial_linear><initial_angular>0 0 0</initial_angular></plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions><odom_publish_frequency>50</odom_publish_frequency><odom_frame>world</odom_frame><robot_base_frame>base_link</robot_base_frame></plugin>
    </model>

    <!-- ════════════════════════════════════════════════════════════════════
         UAV_GAMMA — Green rotors — spawns at (-8, 0, 0.2)
    ════════════════════════════════════════════════════════════════════════ -->
    <model name="uav_gamma">
      <pose>-8 0 0.2 0 0 0</pose>
      <static>false</static>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>1.5</mass><inertia><ixx>0.03475</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.07000</iyy><iyz>0</iyz><izz>0.09770</izz></inertia></inertial>
        <collision name="col"><geometry><box><size>0.47 0.47 0.11</size></box></geometry></collision>
        <visual name="body"><geometry><mesh><scale>1.5 1.5 1.5</scale><uri>model://x3_uav/meshes/x3.dae</uri></mesh></geometry></visual>
        <visual name="r_fl"><pose>0.20 -0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>0.2 1.0 0.2 1</ambient><diffuse>0.2 1.0 0.2 1</diffuse></material></visual>
        <visual name="r_rr"><pose>-0.20 0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>0.2 1.0 0.2 1</ambient><diffuse>0.2 1.0 0.2 1</diffuse></material></visual>
        <visual name="r_fr"><pose>0.20 0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>1.0 0.2 0.2 1</ambient><diffuse>1.0 0.2 0.2 1</diffuse></material></visual>
        <visual name="r_rl"><pose>-0.20 -0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>1.0 0.2 0.2 1</ambient><diffuse>1.0 0.2 0.2 1</diffuse></material></visual>
        <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>200</update_rate><topic>/uav_gamma/imu</topic></sensor>
        <sensor name="lidar" type="gpu_lidar"><pose>0 0 0.1 0 0 0</pose><topic>/uav_gamma/lidar/points</topic><update_rate>10</update_rate><ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal><vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.261799</min_angle><max_angle>0.261799</max_angle></vertical></scan><range><min>0.1</min><max>30.0</max></range></ray><always_on>1</always_on></sensor>
        <sensor name="cam" type="camera"><pose>0.15 0 0 0 0 0</pose><topic>/uav_gamma/camera/image_raw</topic><update_rate>30</update_rate><camera><horizontal_fov>1.3962634</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>0.1</near><far>100</far></clip></camera><always_on>1</always_on></sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"><link_name>base_link</link_name><topic>/uav_gamma/gazebo/command/twist</topic><initial_linear>0 0 0</initial_linear><initial_angular>0 0 0</initial_angular></plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions><odom_publish_frequency>50</odom_publish_frequency><odom_frame>world</odom_frame><robot_base_frame>base_link</robot_base_frame></plugin>
    </model>

    <!-- ════════════════════════════════════════════════════════════════════
         UAV_DELTA — Magenta rotors — spawns at (0, 8, 0.2)
    ════════════════════════════════════════════════════════════════════════ -->
    <model name="uav_delta">
      <pose>0 8 0.2 0 0 0</pose>
      <static>false</static>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>1.5</mass><inertia><ixx>0.03475</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.07000</iyy><iyz>0</iyz><izz>0.09770</izz></inertia></inertial>
        <collision name="col"><geometry><box><size>0.47 0.47 0.11</size></box></geometry></collision>
        <visual name="body"><geometry><mesh><scale>1.5 1.5 1.5</scale><uri>model://x3_uav/meshes/x3.dae</uri></mesh></geometry></visual>
        <visual name="r_fl"><pose>0.20 -0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>1.0 0.2 0.8 1</ambient><diffuse>1.0 0.2 0.8 1</diffuse></material></visual>
        <visual name="r_rr"><pose>-0.20 0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>1.0 0.2 0.8 1</ambient><diffuse>1.0 0.2 0.8 1</diffuse></material></visual>
        <visual name="r_fr"><pose>0.20 0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>1.0 0.2 0.2 1</ambient><diffuse>1.0 0.2 0.2 1</diffuse></material></visual>
        <visual name="r_rl"><pose>-0.20 -0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>1.0 0.2 0.2 1</ambient><diffuse>1.0 0.2 0.2 1</diffuse></material></visual>
        <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>200</update_rate><topic>/uav_delta/imu</topic></sensor>
        <sensor name="lidar" type="gpu_lidar"><pose>0 0 0.1 0 0 0</pose><topic>/uav_delta/lidar/points</topic><update_rate>10</update_rate><ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal><vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.261799</min_angle><max_angle>0.261799</max_angle></vertical></scan><range><min>0.1</min><max>30.0</max></range></ray><always_on>1</always_on></sensor>
        <sensor name="cam" type="camera"><pose>0.15 0 0 0 0 0</pose><topic>/uav_delta/camera/image_raw</topic><update_rate>30</update_rate><camera><horizontal_fov>1.3962634</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>0.1</near><far>100</far></clip></camera><always_on>1</always_on></sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"><link_name>base_link</link_name><topic>/uav_delta/gazebo/command/twist</topic><initial_linear>0 0 0</initial_linear><initial_angular>0 0 0</initial_angular></plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions><odom_publish_frequency>50</odom_publish_frequency><odom_frame>world</odom_frame><robot_base_frame>base_link</robot_base_frame></plugin>
    </model>

    <!-- ════════════════════════════════════════════════════════════════════
         UAV_EPSILON — Yellow rotors — spawns at (0, -8, 0.2)
    ════════════════════════════════════════════════════════════════════════ -->
    <model name="uav_epsilon">
      <pose>0 -8 0.2 0 0 0</pose>
      <static>false</static>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>1.5</mass><inertia><ixx>0.03475</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.07000</iyy><iyz>0</iyz><izz>0.09770</izz></inertia></inertial>
        <collision name="col"><geometry><box><size>0.47 0.47 0.11</size></box></geometry></collision>
        <visual name="body"><geometry><mesh><scale>1.5 1.5 1.5</scale><uri>model://x3_uav/meshes/x3.dae</uri></mesh></geometry></visual>
        <visual name="r_fl"><pose>0.20 -0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>1.0 1.0 0.0 1</ambient><diffuse>1.0 1.0 0.0 1</diffuse></material></visual>
        <visual name="r_rr"><pose>-0.20 0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>1.0 1.0 0.0 1</ambient><diffuse>1.0 1.0 0.0 1</diffuse></material></visual>
        <visual name="r_fr"><pose>0.20 0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>1.0 0.2 0.2 1</ambient><diffuse>1.0 0.2 0.2 1</diffuse></material></visual>
        <visual name="r_rl"><pose>-0.20 -0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>1.0 0.2 0.2 1</ambient><diffuse>1.0 0.2 0.2 1</diffuse></material></visual>
        <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>200</update_rate><topic>/uav_epsilon/imu</topic></sensor>
        <sensor name="lidar" type="gpu_lidar"><pose>0 0 0.1 0 0 0</pose><topic>/uav_epsilon/lidar/points</topic><update_rate>10</update_rate><ray><scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal><vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.261799</min_angle><max_angle>0.261799</max_angle></vertical></scan><range><min>0.1</min><max>30.0</max></range></ray><always_on>1</always_on></sensor>
        <sensor name="cam" type="camera"><pose>0.15 0 0 0 0 0</pose><topic>/uav_epsilon/camera/image_raw</topic><update_rate>30</update_rate><camera><horizontal_fov>1.3962634</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>0.1</near><far>100</far></clip></camera><always_on>1</always_on></sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"><link_name>base_link</link_name><topic>/uav_epsilon/gazebo/command/twist</topic><initial_linear>0 0 0</initial_linear><initial_angular>0 0 0</initial_angular></plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions><odom_publish_frequency>50</odom_publish_frequency><odom_frame>world</odom_frame><robot_base_frame>base_link</robot_base_frame></plugin>
    </model>

  </world>
</sdf>
