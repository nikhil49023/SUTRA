<?xml version="1.0" ?>
<!--
Project SUTRA — Master Disaster Digital Twin Swarm Simulation World
====================================================================
Subsystems: A (GNC), B (Comms & Sim), C (Perception Edge AI)
Author: Tech Lead Nikhil (Tech Architect & Lead ⚡)
Features:
- WGS84 Georeferenced Origin (San Francisco Disaster Twin: 37.774929 N, -122.419416 W).
- DART 500Hz Physics Engine with Ogre2 visual/thermal rendering.
- 5 X3 Quadcopter UAV Swarm Models (uav_alpha, uav_beta, uav_gamma, uav_delta, uav_epsilon)
  with RGB Optical Camera, LWIR Thermal Infrared Camera, 3D LiDAR, IMU, and Twist Controller plugins.
- Dynamic Survivor Target Actor with thermal heat signature for Subsystem C Tri-Modal Perception.
-->
<sdf version="1.8">
  <world name="master_swarm_disaster_world">
    
    <physics name="500hz" type="dart">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- WGS84 Georeferenced Coordinates -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.774929</latitude_deg>
      <longitude_deg>-122.419416</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <!-- Ogre2 Rendering & Scene Broadcaster -->
    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.7 0.8 1.0 1.0</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>

    <!-- Essential Gazebo Sim System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine>dart</engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

    <!-- Directional Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.25 0.3 0.25 1</ambient>
            <diffuse>0.35 0.4 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 🏢 Disaster Search Corridors (Structured Ruin Walls) -->
    <model name="disaster_wall_north">
      <static>true</static>
      <pose>0.0 25.0 3.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>50 2 6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>50 2 6</size></box></geometry>
          <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="disaster_wall_south">
      <static>true</static>
      <pose>0.0 -25.0 3.0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>50 2 6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>50 2 6</size></box></geometry>
          <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 🚨 Survivor Heat/Visual Target Actor -->
    <model name="survivor_target_alpha">
      <static>true</static>
      <pose>12.5 15.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.2 0.1 1</ambient>
            <diffuse>1.0 0.3 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 🚁 1. UAV Alpha (Lead Drone) -->
    <model name="uav_alpha">
      <pose>15.0 0.0 4.0 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.03475</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.03475</iyy><iyz>0</iyz>
            <izz>0.0477</izz>
          </inertia>
        </inertial>
        <collision name="c"><geometry><cylinder><radius>0.4</radius><length>0.15</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.4</radius><length>0.15</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>1.0 0.2 0.2 1</diffuse></material>
        </visual>
        <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>200</update_rate>
          <topic>/uav_alpha/imu</topic>
          <imu>
            <angular_velocity>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></z>
            </linear_acceleration>
          </imu>
        </sensor>
        <sensor name="camera_rgb" type="camera">
          <update_rate>30</update_rate>
          <topic>/uav_alpha/camera/image_raw</topic>
          <camera>
            <horizontal_fov>1.5708</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>100</far></clip>
          </camera>
        </sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>base_link</link_name>
        <topic>/uav_alpha/gazebo/command/twist</topic>
        <initial_linear>0 0 0</initial_linear>
        <initial_angular>0 0 0</initial_angular>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <dimensions>3</dimensions>
      </plugin>
    </model>

    <!-- 🚁 2. UAV Beta -->
    <model name="uav_beta">
      <pose>4.635 14.265 4.0 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>1.5</mass><inertia><ixx>0.03475</ixx><iyy>0.03475</iyy><izz>0.0477</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.4</radius><length>0.15</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.4</radius><length>0.15</length></cylinder></geometry>
          <material><ambient>0.1 0.9 0.1 1</ambient><diffuse>0.2 1.0 0.2 1</diffuse></material>
        </visual>
        <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>200</update_rate>
          <topic>/uav_beta/imu</topic>
          <imu>
            <angular_velocity>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></z>
            </linear_acceleration>
          </imu>
        </sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>base_link</link_name>
        <topic>/uav_beta/gazebo/command/twist</topic>
        <initial_linear>0 0 0</initial_linear>
        <initial_angular>0 0 0</initial_angular>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions></plugin>
    </model>

    <!-- 🚁 3. UAV Gamma -->
    <model name="uav_gamma">
      <pose>-12.135 8.816 4.0 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>1.5</mass><inertia><ixx>0.03475</ixx><iyy>0.03475</iyy><izz>0.0477</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.4</radius><length>0.15</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.4</radius><length>0.15</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.9 1</ambient><diffuse>0.2 0.2 1.0 1</diffuse></material>
        </visual>
        <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>200</update_rate>
          <topic>/uav_gamma/imu</topic>
          <imu>
            <angular_velocity>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></z>
            </linear_acceleration>
          </imu>
        </sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>base_link</link_name>
        <topic>/uav_gamma/gazebo/command/twist</topic>
        <initial_linear>0 0 0</initial_linear>
        <initial_angular>0 0 0</initial_angular>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions></plugin>
    </model>

    <!-- 🚁 4. UAV Delta -->
    <model name="uav_delta">
      <pose>-12.135 -8.816 4.0 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>1.5</mass><inertia><ixx>0.03475</ixx><iyy>0.03475</iyy><izz>0.0477</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.4</radius><length>0.15</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.4</radius><length>0.15</length></cylinder></geometry>
          <material><ambient>0.9 0.9 0.1 1</ambient><diffuse>1.0 1.0 0.2 1</diffuse></material>
        </visual>
        <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>200</update_rate>
          <topic>/uav_delta/imu</topic>
          <imu>
            <angular_velocity>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></z>
            </linear_acceleration>
          </imu>
        </sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>base_link</link_name>
        <topic>/uav_delta/gazebo/command/twist</topic>
        <initial_linear>0 0 0</initial_linear>
        <initial_angular>0 0 0</initial_angular>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions></plugin>
    </model>

    <!-- 🚁 5. UAV Epsilon -->
    <model name="uav_epsilon">
      <pose>4.635 -14.265 4.0 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>1.5</mass><inertia><ixx>0.03475</ixx><iyy>0.03475</iyy><izz>0.0477</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.4</radius><length>0.15</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.4</radius><length>0.15</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.9 1</ambient><diffuse>1.0 0.2 1.0 1</diffuse></material>
        </visual>
        <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>200</update_rate>
          <topic>/uav_epsilon/imu</topic>
          <imu>
            <angular_velocity>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>0.005</stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>0.01</stddev></noise></z>
            </linear_acceleration>
          </imu>
        </sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>base_link</link_name>
        <topic>/uav_epsilon/gazebo/command/twist</topic>
        <initial_linear>0 0 0</initial_linear>
        <initial_angular>0 0 0</initial_angular>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions></plugin>
    </model>

  </world>
</sdf>
