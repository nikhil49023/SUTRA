<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="master_swarm_disaster_world">
    
    <!-- 500Hz Physics Solver (PX4 Aerodynamics & RF Mesh Sync) -->
    <physics name="500hz_physics" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- Gazebo Sim 8 Core System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>

    <!-- WGS84 Spherical Coordinates (San Francisco SAR Disaster Zone) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>37.774929</latitude_deg>
      <longitude_deg>-122.419416</longitude_deg>
      <elevation>15.0</elevation>
    </spherical_coordinates>

    <!-- Directional Sun Lighting with Shadow Mapping -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>100 100 150 0 0 0</pose>
      <diffuse>0.95 0.95 0.90 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </light>

    <!-- Disaster Ground Terrain Elevation Base -->
    <model name="disaster_ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.3 0.2 1</ambient>
            <diffuse>0.3 0.4 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Collapsed Structural Complex 1 (Concrete Wall Block) -->
    <model name="collapsed_building_complex_1">
      <static>true</static>
      <pose>35 20 4.0 0.1 0.15 0.5</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>25 18 8</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>25 18 8</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.42 1</ambient>
            <diffuse>0.6 0.6 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Collapsed Building Ruin 2 (High RF Attenuation Obstacle) -->
    <model name="collapsed_building_complex_2">
      <static>true</static>
      <pose>-30 50 6.0 -0.1 0.2 1.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>30 20 12</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>30 20 12</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.35 1</ambient>
            <diffuse>0.5 0.5 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Forest Canopy Cluster (Log-Normal Fading Zone n=2.7) -->
    <model name="forest_canopy_foliage_zone">
      <static>true</static>
      <pose>70 0 7.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>12.0</radius><length>15.0</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>12.0</radius><length>15.0</length></cylinder>
          </geometry>
          <material>
            <ambient>0.08 0.35 0.08 1</ambient>
            <diffuse>0.15 0.55 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Survivor Human Victim Target (Red Capsule Marker) -->
    <model name="survivor_victim_target">
      <static>true</static>
      <pose>40 22 0.8 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <capsule><radius>0.4</radius><length>1.8</length></capsule>
          </geometry>
          <material>
            <ambient>0.9 0.1 0.1 1</ambient>
            <diffuse>1.0 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================= -->
    <!--                   5 SWARM DRONE DIGITAL TWINS                     -->
    <!-- ================================================================= -->

    <!-- Drone 1: UAV Alpha (Swarm Leader) -->
    <model name="uav_alpha">
      <pose>0 0 15 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>1.45</mass><inertia><ixx>0.02</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.02</iyy><iyz>0</iyz><izz>0.04</izz></inertia></inertial>
        <visual name="visual">
          <geometry><box><size>0.45 0.45 0.15</size></box></geometry>
          <material><ambient>0.1 0.6 1.0 1</ambient><diffuse>0.2 0.7 1.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Drone 2: UAV Beta (Swarm Peer 1) -->
    <model name="uav_beta">
      <pose>25 30 18 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>1.45</mass><inertia><ixx>0.02</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.02</iyy><iyz>0</iyz><izz>0.04</izz></inertia></inertial>
        <visual name="visual">
          <geometry><box><size>0.45 0.45 0.15</size></box></geometry>
          <material><ambient>0.1 1.0 0.4 1</ambient><diffuse>0.2 1.0 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Drone 3: UAV Gamma (Swarm Peer 2) -->
    <model name="uav_gamma">
      <pose>-40 45 14 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>1.45</mass><inertia><ixx>0.02</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.02</iyy><iyz>0</iyz><izz>0.04</izz></inertia></inertial>
        <visual name="visual">
          <geometry><box><size>0.45 0.45 0.15</size></box></geometry>
          <material><ambient>1.0 0.8 0.1 1</ambient><diffuse>1.0 0.9 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Drone 4: UAV Delta (Swarm Peer 3) -->
    <model name="uav_delta">
      <pose>60 -20 20 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>1.45</mass><inertia><ixx>0.02</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.02</iyy><iyz>0</iyz><izz>0.04</izz></inertia></inertial>
        <visual name="visual">
          <geometry><box><size>0.45 0.45 0.15</size></box></geometry>
          <material><ambient>0.9 0.2 0.9 1</ambient><diffuse>1.0 0.3 1.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Drone 5: UAV Epsilon (Multi-Hop Relay Node) -->
    <model name="uav_epsilon">
      <pose>120 10 16 0 0 0</pose>
      <link name="base_link">
        <inertial><mass>1.45</mass><inertia><ixx>0.02</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.02</iyy><iyz>0</iyz><izz>0.04</izz></inertia></inertial>
        <visual name="visual">
          <geometry><box><size>0.45 0.45 0.15</size></box></geometry>
          <material><ambient>0.2 0.9 0.9 1</ambient><diffuse>0.3 1.0 1.0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
