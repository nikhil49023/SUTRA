<?xml version="1.0" ?>
<!--
Project SUTRA — High-Fidelity Master Disaster Swarm Simulation World
====================================================================
Subsystems: A (GNC), B (Comms & Sim), C (Perception Edge AI), D (GCS)
Author: Tech Lead Nikhil (Tech Architect & Lead ⚡)

Features:
- High-Fidelity 3D OpenRobotics X3 UAV Quadcopter Meshes with 4 Rotors per Drone.
- 5 Swarm UAVs (uav_alpha, uav_beta, uav_gamma, uav_delta, uav_epsilon) with distinct LED lighting.
- WGS84 Georeferenced Origin (San Francisco Disaster Twin: 37.774929 N, -122.419416 W).
- 500Hz DART physics engine with Ogre2 GPU rendering.
- Open 80m x 80m disaster search arena with ruined columns, survivor target actor, and thermal beacons.
-->
<sdf version="1.8">
  <world name="master_swarm_disaster_world">
    
    <physics name="500hz" type="dart">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- WGS84 Georeferenced Coordinates -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.774929</latitude_deg>
      <longitude_deg>-122.419416</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <!-- Ogre2 Rendering & Scene Broadcaster -->
    <scene>
      <ambient>0.45 0.48 0.52 1.0</ambient>
      <background>0.65 0.75 0.88 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Essential Gazebo Sim System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine>dart</engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure" />
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />

    <!-- Directional Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.95 0.95 0.90 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Ambient Sky Fill Light -->
    <light type="directional" name="sky_fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.25 0.30 0.40 1</diffuse>
      <direction>0.4 -0.2 -0.7</direction>
    </light>

    <!-- 🌍 Textured Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>300 300</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>300 300</size></plane></geometry>
          <material>
            <ambient>0.32 0.35 0.30 1</ambient>
            <diffuse>0.40 0.45 0.38 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 🏛️ Disaster Ruin Obstacles (Distributed Outside Central Corridor) -->
    <model name="ruin_pillar_1">
      <static>true</static>
      <pose>18.0 20.0 2.5 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3 3 5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>3 3 5</size></box></geometry>
          <material><ambient>0.45 0.42 0.40 1</ambient><diffuse>0.55 0.50 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="ruin_pillar_2">
      <static>true</static>
      <pose>-20.0 18.0 2.0 0 0 -0.2</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>4 3 4</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>4 3 4</size></box></geometry>
          <material><ambient>0.45 0.42 0.40 1</ambient><diffuse>0.55 0.50 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="ruin_pillar_3">
      <static>true</static>
      <pose>-18.0 -22.0 3.0 0 0 0.5</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.5 3.5 6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>3.5 3.5 6</size></box></geometry>
          <material><ambient>0.45 0.42 0.40 1</ambient><diffuse>0.55 0.50 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="ruin_pillar_4">
      <static>true</static>
      <pose>22.0 -18.0 2.5 0 0 -0.4</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3 4 5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>3 4 5</size></box></geometry>
          <material><ambient>0.45 0.42 0.40 1</ambient><diffuse>0.55 0.50 0.48 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 🚨 Survivor Search Target (Central Survivor Pod with Thermal Signature) -->
    <model name="survivor_target_alpha">
      <static>true</static>
      <pose>0.0 0.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.6</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name="v_body">
          <geometry><cylinder><radius>0.6</radius><length>1.2</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.4 0.1 1</ambient>
            <diffuse>1.0 0.5 0.1 1</diffuse>
            <emissive>0.4 0.2 0.0 1</emissive>
          </material>
        </visual>
        <!-- Glowing Beacon Ring on Ground -->
        <visual name="v_ring">
          <pose>0 0 -0.55 0 0 0</pose>
          <geometry><cylinder><radius>1.8</radius><length>0.05</length></cylinder></geometry>
          <material>
            <ambient>1.0 0.8 0.0 1</ambient>
            <diffuse>1.0 0.85 0.1 1</diffuse>
            <emissive>0.5 0.4 0.0 1</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- 🚁 1. UAV ALPHA (Lead Drone — Neon Cyan & Red Trim)                    -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <model name="uav_alpha">
      <pose>12.0 0.0 4.0 0 0 0</pose>
      <static>false</static>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial>
          <mass>1.5</mass>
          <inertia><ixx>0.03475</ixx><iyy>0.07000</iyy><izz>0.09770</izz></inertia>
        </inertial>
        <collision name="c"><geometry><box><size>0.47 0.47 0.12</size></box></geometry></collision>
        
        <!-- Official X3 3D Quadcopter Body Mesh -->
        <visual name="body">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><scale>1.5 1.5 1.5</scale><uri>model://x3_uav/meshes/x3.dae</uri></mesh></geometry>
        </visual>
        <visual name="prop_fl">
          <pose>0.20 -0.33 0.035 0 0 0</pose>
          <geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry>
          <material><ambient>0.0 0.9 1.0 1</ambient><diffuse>0.0 0.9 1.0 1</diffuse><emissive>0.0 0.3 0.5 1</emissive></material>
        </visual>
        <visual name="prop_rr">
          <pose>-0.20 0.30 0.035 0 0 0</pose>
          <geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry>
          <material><ambient>1.0 0.2 0.2 1</ambient><diffuse>1.0 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="prop_fr">
          <pose>0.20 0.33 0.035 0 0 0</pose>
          <geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry>
          <material><ambient>0.0 0.9 1.0 1</ambient><diffuse>0.0 0.9 1.0 1</diffuse><emissive>0.0 0.3 0.5 1</emissive></material>
        </visual>
        <visual name="prop_rl">
          <pose>-0.20 -0.30 0.035 0 0 0</pose>
          <geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry>
          <material><ambient>1.0 0.2 0.2 1</ambient><diffuse>1.0 0.2 0.2 1</diffuse></material>
        </visual>

        <!-- 🛰️ PHYSICAL HARDWARE PAYLOAD STACK -->
        <visual name="lidar_base"><pose>0 0 0.055 0 0 0</pose><geometry><cylinder><radius>0.042</radius><length>0.022</length></cylinder></geometry><material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.22 0.22 0.26 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual>
        <visual name="lidar_ring"><pose>0 0 0.068 0 0 0</pose><geometry><cylinder><radius>0.039</radius><length>0.016</length></cylinder></geometry><material><ambient>0.0 0.7 0.9 1</ambient><diffuse>0.0 0.85 1.0 1</diffuse><emissive>0.0 0.45 0.85 1</emissive></material></visual>
        <visual name="lidar_cap"><pose>0 0 0.078 0 0 0</pose><geometry><cylinder><radius>0.041</radius><length>0.008</length></cylinder></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
        <visual name="edge_tpu_case"><pose>-0.05 0 0.038 0 0 0</pose><geometry><box><size>0.085 0.065 0.022</size></box></geometry><material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material></visual>
        <visual name="edge_tpu_heatsink"><pose>-0.05 0 0.051 0 0 0</pose><geometry><box><size>0.075 0.055 0.006</size></box></geometry><material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse><specular>0.9 0.9 0.9 1</specular></material></visual>
        <visual name="edge_tpu_led"><pose>-0.015 0.024 0.052 0 0 0</pose><geometry><box><size>0.008 0.008 0.004</size></box></geometry><material><ambient>0.0 1.0 0.3 1</ambient><diffuse>0.0 1.0 0.3 1</diffuse><emissive>0.0 1.0 0.3 1</emissive></material></visual>
        <visual name="gimbal_bracket"><pose>0.135 0 -0.028 0 0.15 0</pose><geometry><box><size>0.035 0.055 0.030</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name="camera_rgb_lens"><pose>0.155 -0.015 -0.030 0 1.5708 0</pose><geometry><cylinder><radius>0.010</radius><length>0.014</length></cylinder></geometry><material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.6 0.9 1</diffuse><emissive>0.0 0.3 0.6 1</emissive></material></visual>
        <visual name="camera_thermal_lens"><pose>0.155 0.015 -0.030 0 1.5708 0</pose><geometry><cylinder><radius>0.012</radius><length>0.014</length></cylinder></geometry><material><ambient>0.8 0.35 0.0 1</ambient><diffuse>0.9 0.45 0.0 1</diffuse><emissive>0.7 0.25 0.0 1</emissive></material></visual>
        <visual name="gps_mast"><pose>-0.10 -0.08 0.065 0 0 0</pose><geometry><cylinder><radius>0.0035</radius><length>0.08</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name="gps_puck"><pose>-0.10 -0.08 0.108 0 0 0</pose><geometry><cylinder><radius>0.022</radius><length>0.010</length></cylinder></geometry><material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.25 0.25 0.30 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
        <visual name="mesh_ant_l"><pose>-0.14 0.11 0.045 0.25 -0.2 0</pose><geometry><cylinder><radius>0.0032</radius><length>0.075</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <visual name="mesh_ant_r"><pose>-0.14 -0.11 0.045 -0.25 -0.2 0</pose><geometry><cylinder><radius>0.0032</radius><length>0.075</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <visual name="battery_pack"><pose>0 0 -0.028 0 0 0</pose><geometry><box><size>0.13 0.048 0.034</size></box></geometry><material><ambient>0.8 0.65 0.0 1</ambient><diffuse>0.9 0.75 0.0 1</diffuse></material></visual>

        <!-- 📡 FULL 9-DOF AVIONICS & TACTICAL SENSORS -->
        <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>250</update_rate><topic>/uav_alpha/imu</topic></sensor>
        <sensor name="air_pressure" type="air_pressure"><always_on>1</always_on><update_rate>50</update_rate><topic>/uav_alpha/air_pressure</topic><air_pressure><reference_altitude>0.0</reference_altitude><pressure><noise type="gaussian"><mean>0.0</mean><stddev>1.2</stddev></noise></pressure></air_pressure></sensor>
        <sensor name="magnetometer" type="magnetometer"><always_on>1</always_on><update_rate>50</update_rate><topic>/uav_alpha/magnetometer</topic></sensor>
        <sensor name="navsat" type="navsat"><always_on>1</always_on><update_rate>10</update_rate><topic>/uav_alpha/navsat</topic></sensor>
        <sensor name="lidar" type="gpu_lidar"><pose>0 0 0.1 0 0 0</pose><topic>/uav_alpha/lidar/points</topic><update_rate>10</update_rate><ray><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal><vertical><samples>32</samples><resolution>1</resolution><min_angle>-0.436332</min_angle><max_angle>0.261799</max_angle></vertical></scan><range><min>0.1</min><max>50.0</max></range></ray><always_on>1</always_on></sensor>
        <sensor name="rangefinder" type="gpu_lidar"><pose>0 0 -0.04 0 1.5707963 0</pose><topic>/uav_alpha/rangefinder/distance</topic><update_rate>50</update_rate><ray><scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal><vertical><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan><range><min>0.05</min><max>40.0</max></range></ray><always_on>1</always_on></sensor>
        <sensor name="camera_rgb" type="camera"><pose>0.15 0 0 0 0 0</pose><update_rate>30</update_rate><topic>/uav_alpha/camera/image_raw</topic><camera><horizontal_fov>1.3962634</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>0.1</near><far>150</far></clip></camera><always_on>1</always_on></sensor>
        <sensor name="camera_thermal" type="thermal"><pose>0.15 0 -0.03 0 0 0</pose><update_rate>30</update_rate><topic>/uav_alpha/thermal_camera/image_raw</topic><camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>L8</format></image></camera><always_on>1</always_on></sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>base_link</link_name><topic>/uav_alpha/gazebo/command/twist</topic>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions></plugin>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- 🚁 2. UAV BETA (Neon Green & Amber Trim)                               -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <model name="uav_beta">
      <pose>3.7 11.4 4.0 0 0 0</pose>
      <static>false</static>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>1.5</mass><inertia><ixx>0.03475</ixx><iyy>0.07000</iyy><izz>0.09770</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.47 0.47 0.12</size></box></geometry></collision>
        <visual name="body">
          <pose>0 0 0 0 0 0</pose>
          <geometry><mesh><scale>1.5 1.5 1.5</scale><uri>model://x3_uav/meshes/x3.dae</uri></mesh></geometry>
        </visual>
        <visual name="prop_fl">
          <pose>0.20 -0.33 0.035 0 0 0</pose>
          <geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry>
          <material><ambient>0.1 1.0 0.3 1</ambient><diffuse>0.1 1.0 0.3 1</diffuse><emissive>0.0 0.4 0.1 1</emissive></material>
        </visual>
        <visual name="prop_rr">
          <pose>-0.20 0.30 0.035 0 0 0</pose>
          <geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry>
          <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material>
        </visual>
        <visual name="prop_fr">
          <pose>0.20 0.33 0.035 0 0 0</pose>
          <geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry>
          <material><ambient>0.1 1.0 0.3 1</ambient><diffuse>0.1 1.0 0.3 1</diffuse><emissive>0.0 0.4 0.1 1</emissive></material>
        </visual>
        <visual name="prop_rl">
          <pose>-0.20 -0.30 0.035 0 0 0</pose>
          <geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry>
          <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material>
        </visual>
        <!-- 🛰️ PHYSICAL HARDWARE PAYLOAD STACK -->
        <visual name="lidar_base"><pose>0 0 0.055 0 0 0</pose><geometry><cylinder><radius>0.042</radius><length>0.022</length></cylinder></geometry><material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.22 0.22 0.26 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual>
        <visual name="lidar_ring"><pose>0 0 0.068 0 0 0</pose><geometry><cylinder><radius>0.039</radius><length>0.016</length></cylinder></geometry><material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.6 0.0 1</diffuse><emissive>0.8 0.4 0.0 1</emissive></material></visual>
        <visual name="lidar_cap"><pose>0 0 0.078 0 0 0</pose><geometry><cylinder><radius>0.041</radius><length>0.008</length></cylinder></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
        <visual name="edge_tpu_case"><pose>-0.05 0 0.038 0 0 0</pose><geometry><box><size>0.085 0.065 0.022</size></box></geometry><material><ambient>0.1 0.1 0.12 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material></visual>
        <visual name="edge_tpu_heatsink"><pose>-0.05 0 0.051 0 0 0</pose><geometry><box><size>0.075 0.055 0.006</size></box></geometry><material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse><specular>0.9 0.9 0.9 1</specular></material></visual>
        <visual name="edge_tpu_led"><pose>-0.015 0.024 0.052 0 0 0</pose><geometry><box><size>0.008 0.008 0.004</size></box></geometry><material><ambient>0.0 1.0 0.3 1</ambient><diffuse>0.0 1.0 0.3 1</diffuse><emissive>0.0 1.0 0.3 1</emissive></material></visual>
        <visual name="gimbal_bracket"><pose>0.135 0 -0.028 0 0.15 0</pose><geometry><box><size>0.035 0.055 0.030</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name="camera_rgb_lens"><pose>0.155 -0.015 -0.030 0 1.5708 0</pose><geometry><cylinder><radius>0.010</radius><length>0.014</length></cylinder></geometry><material><ambient>0.1 0.4 0.8 1</ambient><diffuse>0.1 0.6 0.9 1</diffuse><emissive>0.0 0.3 0.6 1</emissive></material></visual>
        <visual name="camera_thermal_lens"><pose>0.155 0.015 -0.030 0 1.5708 0</pose><geometry><cylinder><radius>0.012</radius><length>0.014</length></cylinder></geometry><material><ambient>0.8 0.35 0.0 1</ambient><diffuse>0.9 0.45 0.0 1</diffuse><emissive>0.7 0.25 0.0 1</emissive></material></visual>
        <visual name="gps_mast"><pose>-0.10 -0.08 0.065 0 0 0</pose><geometry><cylinder><radius>0.0035</radius><length>0.08</length></cylinder></geometry><material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
        <visual name="gps_puck"><pose>-0.10 -0.08 0.108 0 0 0</pose><geometry><cylinder><radius>0.022</radius><length>0.010</length></cylinder></geometry><material><ambient>0.15 0.15 0.18 1</ambient><diffuse>0.25 0.25 0.30 1</diffuse><specular>0.6 0.6 0.6 1</specular></material></visual>
        <visual name="mesh_ant_l"><pose>-0.14 0.11 0.045 0.25 -0.2 0</pose><geometry><cylinder><radius>0.0032</radius><length>0.075</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
        <visual name="mesh_ant_r"><pose>-0.14 -0.11 0.045 -0.25 -0.2 0</pose><geometry><cylinder><radius>0.0032</radius><length>0.075</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
