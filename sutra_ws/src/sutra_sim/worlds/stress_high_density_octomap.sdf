<?xml version="1.0" ?>
<!--
Project SUTRA — Stress Scenario 4: High-Density 3D Voxel OctoMap Mapping
Complex Rubble & Collapsed Structure World for 0.10m Voxel Grid Throughput Testing.
-->
<sdf version="1.8">
  <world name="stress_high_density_octomap">
    
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Ogre2 GPU Rendering & Scene Configuration -->
    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.7 0.8 1.0 1.0</background>
      <shadows>true</shadows>
      <grid>true</grid>
    </scene>

    <!-- Essential Gazebo Sim Systems -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry></collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.3 0.5 0.3 1</ambient>
            <diffuse>0.3 0.5 0.3 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle Cluster 1: Collapsed Ruined Pillars -->
    <model name="ruined_pillars">
      <static>true</static>
      <pose>10 0 3 0 0.3 0.5</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>2 8 6</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>2 8 6</size></box></geometry><material><ambient>0.4 0.4 0.4 1</ambient></material></visual>
      </link>
    </model>

    <!-- Obstacle Cluster 2: Rubble Debris Field -->
    <model name="rubble_field">
      <static>true</static>
      <pose>18 5 2 0.2 -0.4 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5 5 4</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5 5 4</size></box></geometry><material><ambient>0.5 0.3 0.2 1</ambient></material></visual>
      </link>
    </model>

    <!-- OpenRobotics X3 Quadcopter -->
    <model name="uav_alpha">
      <pose>0 0 2.0 0 0 0</pose>
      <include><uri>model://x3_uav</uri></include>
      <link name="base_link">
        <sensor name="uav_alpha_lidar" type="gpu_lidar">
          <pose>0 0 0.1 0 0 0</pose>
          <topic>/uav_alpha/lidar/points</topic>
          <update_rate>10</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>16</samples>
                <resolution>1</resolution>
                <min_angle>-0.261799</min_angle>
                <max_angle>0.261799</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.1</min>
              <max>30.0</max>
            </range>
          </ray>
          <always_on>1</always_on>
        </sensor>

        <sensor name="uav_alpha_thermal" type="thermal">
          <pose>0.1 0 0 0 0 0</pose>
          <topic>/uav_alpha/thermal/image_raw</topic>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>640</width><height>480</height><format>L8</format></image>
            <clip><near>0.1</near><far>100</far></clip>
          </camera>
          <always_on>1</always_on>
        </sensor>

        <sensor name="uav_alpha_camera" type="camera">
          <pose>0.15 0 0 0 0 0</pose>
          <topic>/uav_alpha/camera/image_raw</topic>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.3962634</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>100</far></clip>
          </camera>
          <always_on>1</always_on>
        </sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>base_link</link_name>
        <topic>/uav_alpha/gazebo/command/twist</topic>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_frame>world</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
      </plugin>
    </model>

  </world>
</sdf>
