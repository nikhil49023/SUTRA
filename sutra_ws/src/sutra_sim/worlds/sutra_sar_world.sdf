              <size>10 0.3 6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
          <pose>0 4.85 3 0 0 0.1</pose>
        </visual>
        <visual name="wall_east">
          <geometry>
            <box>
              <size>0.3 10 7</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
          <pose>4.85 0 3.5 0 0 0</pose>
        </visual>
        <visual name="wall_west">
          <geometry>
            <box>
              <size>0.3 10 5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
          <pose>-4.85 0 2.5 0 0 0.2</pose>
        </visual>
        <visual name="roof">
          <geometry>
            <box>
              <size>10 10 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.5 0.4 0.3 1</diffuse>
          </material>
          <pose>0 0 8 0 0 0.3</pose>
        </visual>
        <visual name="floor">
          <geometry>
            <box>
              <size>10 10 0.3</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
          <pose>0 0 0.15 0 0 0</pose>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>10 10 8</size>
            </box>
          </geometry>
          <pose>0 0 4 0 0 0</pose>
        </collision>
      </link>
    </model>

    <!-- Building 2: Intact with debris -->
    <model name="building_2">
      <static>true</static>
      <pose>-40 30 0 0 0 0.5</pose>
      <link name="link">
        <visual name="walls">
          <geometry>
            <box>
              <size>8 8 10</size>
