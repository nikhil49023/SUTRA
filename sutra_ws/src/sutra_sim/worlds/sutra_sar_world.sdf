<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="sutra_sar_disaster_world">
    <!-- Physics: 500Hz for high-fidelity PX4 SITL -->
    <physics name="500hz_physics" type="dart">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- Gazebo plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-thermal-camera-system" name="gz::sim::systems::ThermalCamera"/>

    <!-- Geographic coordinates: San Francisco disaster zone -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>37.774929</latitude_deg>
      <longitude_deg>-122.419416</longitude_deg>
      <elevation>15.0</elevation>
    </spherical_coordinates>

    <!-- Lighting: afternoon sun with shadows -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.2 -0.8</direction>
    </light>

    <!-- Ambient light for better visibility -->
    <light type="ambient" name="ambient_light">
      <diffuse>0.3 0.3 0.3 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
    </light>

    <!-- ==================== TERRAIN ==================== -->
    <model name="terrain">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <heightmap>
              <uri>file://media/materials/textures/terrain_heightmap.png</uri>
              <size>200 200 20 0 0 0</size>
            </heightmap>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <heightmap>
              <uri>file://media/materials/textures/terrain_heightmap.png</uri>
              <size>200 200 20 0 0 0</size>
              <texture>
                <diffuse>file://media/materials/textures/dirt.png</diffuse>
                <normal>file://media/materials/textures/dirt_normal.png</normal>
                <size>100</size>
              </texture>
              <texture>
                <diffuse>file://media/materials/textures/grass.png</diffuse>
                <normal>file://media/materials/textures/grass_normal.png</normal>
                <size>100</size>
              </texture>
              <texture>
                <diffuse>file://media/materials/textures/rock.png</diffuse>
                <normal>file://media/materials/textures/rock_normal.png</normal>
                <size>100</size>
              </texture>
              <blend>
                <min_height>0</min_height>
                <fade_dist>5</fade_dist>
              </blend>
              <blend>
                <min_height>5</min_height>
                <fade_dist>5</fade_dist>
              </blend>
            </heightmap>
          </visual>
        </visual>
      </link>
    </model>

    <!-- ==================== FLAT TAKEOFF ZONE ==================== -->
    <model name="takeoff_zone">
      <static>true</static>
      <pose>0 0 0.1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>5</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>5</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- ==================== DAMAGED BUILDINGS ==================== -->
    <!-- Building 1: Partially collapsed -->
    <model name="building_1">
      <static>true</static>
      <pose>30 20 0 0 0 0</pose>
      <link name="link">
        <visual name="wall_north">
          <geometry>
            <box>
              <size>10 0.3 8</size>
