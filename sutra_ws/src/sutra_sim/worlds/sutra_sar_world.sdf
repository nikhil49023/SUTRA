    <!-- Building 3: Completely collapsed rubble -->
    <model name="building_3_rubble">
      <static>true</static>
      <pose>20 -35 0 0 0 0</pose>
      <link name="link">
        <visual name="rubble_pile">
          <geometry>
            <sphere>
