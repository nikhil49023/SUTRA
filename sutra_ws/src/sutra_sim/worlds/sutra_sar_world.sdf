            <ambient>0.9 0.7 0.6 1</ambient>
            <diffuse>1.0 0.8 0.7 1</diffuse>
          </material>
          <pose>0 0 1.15 0 0 0</pose>
        </visual>
        <visual name="heat_signature">
          <geometry>
            <sphere>
              <radius>0.3</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1.0 0.2 0.2 1</ambient>
            <diffuse>1.0 0.3 0.3 1</diffuse>
            <emissive>1.0 0.3 0.3 1</emissive>
          </material>
          <pose>0 0 0.6 0 0 0</pose>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>1.0</length>
            </cylinder>
          </geometry>
          <pose>0 0 0.5 0 0 0</pose>
        </collision>
      </link>
    </model>

