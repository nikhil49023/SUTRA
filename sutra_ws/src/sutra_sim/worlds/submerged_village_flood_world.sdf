<?xml version="1.0" ?>
<!--
Project SUTRA — High-Fidelity Master Submerged Flood Disaster Swarm World
========================================================================
Subsystems: A (GNC), B (Comms & Sim), C (Perception Edge AI)
Features:
- High-Fidelity 3D Submerged Village Disaster Terrain.
- 5 Swarm UAV Quadcopters (uav_alpha, uav_beta, uav_gamma, uav_delta, uav_epsilon).
- 500Hz DART physics solver with Ogre2 GPU rendering.
- Full 9-DOF Avionics, RGB + Thermal Cameras, 3D LiDAR, Barometer, Magnetometer, GPS.
-->
<sdf version="1.8">
  <world name="submerged_village_flood_world">
    
    <physics name="500hz" type="dart">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- WGS84 Georeferenced Coordinates -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>30.7346</latitude_deg>
      <longitude_deg>79.0669</longitude_deg>
      <elevation>1800.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <!-- Ogre2 Rendering & Scene Settings -->
    <scene>
      <ambient>0.6 0.65 0.7 1.0</ambient>
      <background>0.5 0.7 0.9 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Gazebo Sim System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine>dart</engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure" />
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />

    <!-- Directional Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 150 0 0 0</pose>
      <diffuse>1.0 1.0 0.95 1</diffuse>
      <specular>0.5 0.5 0.5 1</specular>
      <direction>-0.3 0.2 -1.0</direction>
    </light>

    <!-- Sky Ambient Fill Light -->
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.5 0.6 0.7 1</diffuse>
      <direction>0.3 -0.2 -1.0</direction>
    </light>

    <!-- Ground Plane Base -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
          <material>
            <ambient>0.2 0.25 0.2 1</ambient>
            <diffuse>0.3 0.35 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── 3D Master Submerged Village Flood Model ──────────────────────── -->
    <include>
      <name>submerged_village_disaster</name>
      <uri>model://submerged_village_flood</uri>
      <pose>0 0 38.2 0 0 0</pose>
    </include>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- 🚁 1. UAV ALPHA (Lead Drone — Cyan & Red Trim)                          -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <model name="uav_alpha">
      <pose>-15.0 5.0 50.0 0 0 0</pose>
      <static>false</static>

      <link name="base_link">
        <gravity>false</gravity>
        <inertial>
          <mass>1.5</mass>
          <inertia><ixx>0.03475</ixx><iyy>0.07000</iyy><izz>0.09770</izz></inertia>
        </inertial>
        <collision name="c"><geometry><box><size>0.47 0.47 0.12</size></box></geometry></collision>
        <visual name="body">
          <geometry><mesh><scale>1.5 1.5 1.5</scale><uri>model://x3_uav/meshes/x3.dae</uri></mesh></geometry>
        </visual>
        <visual name="prop_fl">
          <pose>0.20 -0.33 0.035 0 0 0</pose>
          <geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry>
          <material><ambient>0.0 0.9 1.0 1</ambient><diffuse>0.0 0.9 1.0 1</diffuse><emissive>0.0 0.3 0.5 1</emissive></material>
        </visual>
        <visual name="prop_rr">
          <pose>-0.20 0.30 0.035 0 0 0</pose>
          <geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry>
          <material><ambient>1.0 0.2 0.2 1</ambient><diffuse>1.0 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="prop_fr">
          <pose>0.20 0.33 0.035 0 0 0</pose>
          <geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry>
          <material><ambient>0.0 0.9 1.0 1</ambient><diffuse>0.0 0.9 1.0 1</diffuse><emissive>0.0 0.3 0.5 1</emissive></material>
        </visual>
        <visual name="prop_rl">
          <pose>-0.20 -0.30 0.035 0 0 0</pose>
          <geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry>
          <material><ambient>1.0 0.2 0.2 1</ambient><diffuse>1.0 0.2 0.2 1</diffuse></material>
        </visual>

        <!-- Hardware Payload -->
        <visual name="lidar_ring"><pose>0 0 0.068 0 0 0</pose><geometry><cylinder><radius>0.039</radius><length>0.016</length></cylinder></geometry><material><ambient>0.0 0.7 0.9 1</ambient><diffuse>0.0 0.85 1.0 1</diffuse><emissive>0.0 0.45 0.85 1</emissive></material></visual>
        <visual name="battery_pack"><pose>0 0 -0.028 0 0 0</pose><geometry><box><size>0.13 0.048 0.034</size></box></geometry><material><ambient>0.8 0.65 0.0 1</ambient><diffuse>0.9 0.75 0.0 1</diffuse></material></visual>

        <!-- Sensors -->
        <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>250</update_rate><topic>/uav_alpha/imu</topic></sensor>
        <sensor name="air_pressure" type="air_pressure"><always_on>1</always_on><update_rate>50</update_rate><topic>/uav_alpha/air_pressure</topic><air_pressure><reference_altitude>0.0</reference_altitude><pressure><noise type="gaussian"><mean>0.0</mean><stddev>1.2</stddev></noise></pressure></air_pressure></sensor>
        <sensor name="magnetometer" type="magnetometer"><always_on>1</always_on><update_rate>50</update_rate><topic>/uav_alpha/magnetometer</topic></sensor>
        <sensor name="navsat" type="navsat"><always_on>1</always_on><update_rate>10</update_rate><topic>/uav_alpha/navsat</topic></sensor>
        <sensor name="lidar" type="gpu_lidar"><pose>0 0 0.1 0 0 0</pose><topic>/uav_alpha/lidar/points</topic><update_rate>10</update_rate><ray><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal><vertical><samples>32</samples><resolution>1</resolution><min_angle>-0.436332</min_angle><max_angle>0.261799</max_angle></vertical></scan><range><min>0.1</min><max>50.0</max></range></ray><always_on>1</always_on></sensor>
        <sensor name="rangefinder" type="gpu_lidar"><pose>0 0 -0.04 0 1.5707963 0</pose><topic>/uav_alpha/rangefinder/distance</topic><update_rate>50</update_rate><ray><scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal><vertical><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan><range><min>0.05</min><max>40.0</max></range></ray><always_on>1</always_on></sensor>
        <sensor name="camera_rgb" type="camera"><pose>0.15 0 0 0 0 0</pose><update_rate>30</update_rate><topic>/uav_alpha/camera/image_raw</topic><camera><horizontal_fov>1.3962634</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>0.1</near><far>150</far></clip></camera><always_on>1</always_on></sensor>
        <sensor name="camera_thermal" type="thermal"><pose>0.15 0 -0.03 0 0 0</pose><update_rate>30</update_rate><topic>/uav_alpha/thermal_camera/image_raw</topic><camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>L8</format></image></camera><always_on>1</always_on></sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>base_link</link_name><topic>/uav_alpha/gazebo/command/twist</topic>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions></plugin>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- 🚁 2. UAV BETA (Recon West — Neon Green & Amber Trim)                   -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <model name="uav_beta">
      <pose>2.0 -1.0 48.0 0 0 0</pose>
      <static>false</static>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>1.5</mass><inertia><ixx>0.03475</ixx><iyy>0.07000</iyy><izz>0.09770</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.47 0.47 0.12</size></box></geometry></collision>
        <visual name="body"><geometry><mesh><scale>1.5 1.5 1.5</scale><uri>model://x3_uav/meshes/x3.dae</uri></mesh></geometry></visual>
        <visual name="prop_fl"><pose>0.20 -0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>0.1 1.0 0.3 1</ambient><diffuse>0.1 1.0 0.3 1</diffuse><emissive>0.0 0.4 0.1 1</emissive></material></visual>
        <visual name="prop_rr"><pose>-0.20 0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material></visual>
        <visual name="prop_fr"><pose>0.20 0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>0.1 1.0 0.3 1</ambient><diffuse>0.1 1.0 0.3 1</diffuse><emissive>0.0 0.4 0.1 1</emissive></material></visual>
        <visual name="prop_rl"><pose>-0.20 -0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse></material></visual>
        <visual name="lidar_ring"><pose>0 0 0.068 0 0 0</pose><geometry><cylinder><radius>0.039</radius><length>0.016</length></cylinder></geometry><material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.6 0.0 1</diffuse><emissive>0.8 0.4 0.0 1</emissive></material></visual>
        <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>250</update_rate><topic>/uav_beta/imu</topic></sensor>
        <sensor name="air_pressure" type="air_pressure"><always_on>1</always_on><update_rate>50</update_rate><topic>/uav_beta/air_pressure</topic><air_pressure><reference_altitude>0.0</reference_altitude><pressure><noise type="gaussian"><mean>0.0</mean><stddev>1.2</stddev></noise></pressure></air_pressure></sensor>
        <sensor name="magnetometer" type="magnetometer"><always_on>1</always_on><update_rate>50</update_rate><topic>/uav_beta/magnetometer</topic></sensor>
        <sensor name="navsat" type="navsat"><always_on>1</always_on><update_rate>10</update_rate><topic>/uav_beta/navsat</topic></sensor>
        <sensor name="lidar" type="gpu_lidar"><pose>0 0 0.1 0 0 0</pose><topic>/uav_beta/lidar/points</topic><update_rate>10</update_rate><ray><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal><vertical><samples>32</samples><resolution>1</resolution><min_angle>-0.436332</min_angle><max_angle>0.261799</max_angle></vertical></scan><range><min>0.1</min><max>50.0</max></range></ray><always_on>1</always_on></sensor>
        <sensor name="rangefinder" type="gpu_lidar"><pose>0 0 -0.04 0 1.5707963 0</pose><topic>/uav_beta/rangefinder/distance</topic><update_rate>50</update_rate><ray><scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal><vertical><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan><range><min>0.05</min><max>40.0</max></range></ray><always_on>1</always_on></sensor>
        <sensor name="camera_rgb" type="camera"><pose>0.15 0 0 0 0 0</pose><update_rate>30</update_rate><topic>/uav_beta/camera/image_raw</topic><camera><horizontal_fov>1.3962634</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>0.1</near><far>150</far></clip></camera><always_on>1</always_on></sensor>
        <sensor name="camera_thermal" type="thermal"><pose>0.15 0 -0.03 0 0 0</pose><update_rate>30</update_rate><topic>/uav_beta/thermal_camera/image_raw</topic><camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>L8</format></image></camera><always_on>1</always_on></sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"><link_name>base_link</link_name><topic>/uav_beta/gazebo/command/twist</topic></plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions></plugin>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- 🚁 3. UAV GAMMA (Recon East — Neon Blue & Gold Trim)                    -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <model name="uav_gamma">
      <pose>18.5 14.0 52.0 0 0 0</pose>
      <static>false</static>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>1.5</mass><inertia><ixx>0.03475</ixx><iyy>0.07000</iyy><izz>0.09770</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.47 0.47 0.12</size></box></geometry></collision>
        <visual name="body"><geometry><mesh><scale>1.5 1.5 1.5</scale><uri>model://x3_uav/meshes/x3.dae</uri></mesh></geometry></visual>
        <visual name="prop_fl"><pose>0.20 -0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>0.2 0.4 1.0 1</ambient><diffuse>0.2 0.4 1.0 1</diffuse><emissive>0.0 0.1 0.5 1</emissive></material></visual>
        <visual name="prop_rr"><pose>-0.20 0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>1.0 0.8 0.0 1</ambient><diffuse>1.0 0.8 0.0 1</diffuse></material></visual>
        <visual name="prop_fr"><pose>0.20 0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>0.2 0.4 1.0 1</ambient><diffuse>0.2 0.4 1.0 1</diffuse><emissive>0.0 0.1 0.5 1</emissive></material></visual>
        <visual name="prop_rl"><pose>-0.20 -0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>1.0 0.8 0.0 1</ambient><diffuse>1.0 0.8 0.0 1</diffuse></material></visual>
        <visual name="lidar_ring"><pose>0 0 0.068 0 0 0</pose><geometry><cylinder><radius>0.039</radius><length>0.016</length></cylinder></geometry><material><ambient>0.1 0.9 0.3 1</ambient><diffuse>0.2 1.0 0.4 1</diffuse><emissive>0.1 0.7 0.2 1</emissive></material></visual>
        <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>250</update_rate><topic>/uav_gamma/imu</topic></sensor>
        <sensor name="air_pressure" type="air_pressure"><always_on>1</always_on><update_rate>50</update_rate><topic>/uav_gamma/air_pressure</topic><air_pressure><reference_altitude>0.0</reference_altitude><pressure><noise type="gaussian"><mean>0.0</mean><stddev>1.2</stddev></noise></pressure></air_pressure></sensor>
        <sensor name="magnetometer" type="magnetometer"><always_on>1</always_on><update_rate>50</update_rate><topic>/uav_gamma/magnetometer</topic></sensor>
        <sensor name="navsat" type="navsat"><always_on>1</always_on><update_rate>10</update_rate><topic>/uav_gamma/navsat</topic></sensor>
        <sensor name="lidar" type="gpu_lidar"><pose>0 0 0.1 0 0 0</pose><topic>/uav_gamma/lidar/points</topic><update_rate>10</update_rate><ray><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal><vertical><samples>32</samples><resolution>1</resolution><min_angle>-0.436332</min_angle><max_angle>0.261799</max_angle></vertical></scan><range><min>0.1</min><max>50.0</max></range></ray><always_on>1</always_on></sensor>
        <sensor name="rangefinder" type="gpu_lidar"><pose>0 0 -0.04 0 1.5707963 0</pose><topic>/uav_gamma/rangefinder/distance</topic><update_rate>50</update_rate><ray><scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal><vertical><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan><range><min>0.05</min><max>40.0</max></range></ray><always_on>1</always_on></sensor>
        <sensor name="camera_rgb" type="camera"><pose>0.15 0 0 0 0 0</pose><update_rate>30</update_rate><topic>/uav_gamma/camera/image_raw</topic><camera><horizontal_fov>1.3962634</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>0.1</near><far>150</far></clip></camera><always_on>1</always_on></sensor>
        <sensor name="camera_thermal" type="thermal"><pose>0.15 0 -0.03 0 0 0</pose><update_rate>30</update_rate><topic>/uav_gamma/thermal_camera/image_raw</topic><camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>L8</format></image></camera><always_on>1</always_on></sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"><link_name>base_link</link_name><topic>/uav_gamma/gazebo/command/twist</topic></plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions></plugin>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- 🚁 4. UAV DELTA (Recon North — Neon Yellow & Magenta Trim)              -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <model name="uav_delta">
      <pose>0.0 25.0 54.0 0 0 0</pose>
      <static>false</static>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>1.5</mass><inertia><ixx>0.03475</ixx><iyy>0.07000</iyy><izz>0.09770</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.47 0.47 0.12</size></box></geometry></collision>
        <visual name="body"><geometry><mesh><scale>1.5 1.5 1.5</scale><uri>model://x3_uav/meshes/x3.dae</uri></mesh></geometry></visual>
        <visual name="prop_fl"><pose>0.20 -0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>1.0 0.9 0.0 1</ambient><diffuse>1.0 0.9 0.0 1</diffuse><emissive>0.3 0.3 0.0 1</emissive></material></visual>
        <visual name="prop_rr"><pose>-0.20 0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>0.9 0.1 0.9 1</ambient><diffuse>0.9 0.1 0.9 1</diffuse></material></visual>
        <visual name="prop_fr"><pose>0.20 0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>1.0 0.9 0.0 1</ambient><diffuse>1.0 0.9 0.0 1</diffuse><emissive>0.3 0.3 0.0 1</emissive></material></visual>
        <visual name="prop_rl"><pose>-0.20 -0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>0.9 0.1 0.9 1</ambient><diffuse>0.9 0.1 0.9 1</diffuse></material></visual>
        <visual name="lidar_ring"><pose>0 0 0.068 0 0 0</pose><geometry><cylinder><radius>0.039</radius><length>0.016</length></cylinder></geometry><material><ambient>0.9 0.1 0.7 1</ambient><diffuse>1.0 0.2 0.8 1</diffuse><emissive>0.7 0.1 0.6 1</emissive></material></visual>
        <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>250</update_rate><topic>/uav_delta/imu</topic></sensor>
        <sensor name="air_pressure" type="air_pressure"><always_on>1</always_on><update_rate>50</update_rate><topic>/uav_delta/air_pressure</topic><air_pressure><reference_altitude>0.0</reference_altitude><pressure><noise type="gaussian"><mean>0.0</mean><stddev>1.2</stddev></noise></pressure></air_pressure></sensor>
        <sensor name="magnetometer" type="magnetometer"><always_on>1</always_on><update_rate>50</update_rate><topic>/uav_delta/magnetometer</topic></sensor>
        <sensor name="navsat" type="navsat"><always_on>1</always_on><update_rate>10</update_rate><topic>/uav_delta/navsat</topic></sensor>
        <sensor name="lidar" type="gpu_lidar"><pose>0 0 0.1 0 0 0</pose><topic>/uav_delta/lidar/points</topic><update_rate>10</update_rate><ray><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal><vertical><samples>32</samples><resolution>1</resolution><min_angle>-0.436332</min_angle><max_angle>0.261799</max_angle></vertical></scan><range><min>0.1</min><max>50.0</max></range></ray><always_on>1</always_on></sensor>
        <sensor name="rangefinder" type="gpu_lidar"><pose>0 0 -0.04 0 1.5707963 0</pose><topic>/uav_delta/rangefinder/distance</topic><update_rate>50</update_rate><ray><scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal><vertical><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan><range><min>0.05</min><max>40.0</max></range></ray><always_on>1</always_on></sensor>
        <sensor name="camera_rgb" type="camera"><pose>0.15 0 0 0 0 0</pose><update_rate>30</update_rate><topic>/uav_delta/camera/image_raw</topic><camera><horizontal_fov>1.3962634</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>0.1</near><far>150</far></clip></camera><always_on>1</always_on></sensor>
        <sensor name="camera_thermal" type="thermal"><pose>0.15 0 -0.03 0 0 0</pose><update_rate>30</update_rate><topic>/uav_delta/thermal_camera/image_raw</topic><camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>L8</format></image></camera><always_on>1</always_on></sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"><link_name>base_link</link_name><topic>/uav_delta/gazebo/command/twist</topic></plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions></plugin>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <!-- 🚁 5. UAV EPSILON (Recon South — Neon Magenta & Cyan Trim)              -->
    <!-- ═══════════════════════════════════════════════════════════════════════ -->
    <model name="uav_epsilon">
      <pose>-20.0 -20.0 56.0 0 0 0</pose>
      <static>false</static>

      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>1.5</mass><inertia><ixx>0.03475</ixx><iyy>0.07000</iyy><izz>0.09770</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.47 0.47 0.12</size></box></geometry></collision>
        <visual name="body"><geometry><mesh><scale>1.5 1.5 1.5</scale><uri>model://x3_uav/meshes/x3.dae</uri></mesh></geometry></visual>
        <visual name="prop_fl"><pose>0.20 -0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>1.0 0.1 0.9 1</ambient><diffuse>1.0 0.1 0.9 1</diffuse><emissive>0.4 0.0 0.4 1</emissive></material></visual>
        <visual name="prop_rr"><pose>-0.20 0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_ccw.dae</uri></mesh></geometry><material><ambient>0.0 0.9 1.0 1</ambient><diffuse>0.0 0.9 1.0 1</diffuse></material></visual>
        <visual name="prop_fr"><pose>0.20 0.33 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>1.0 0.1 0.9 1</ambient><diffuse>1.0 0.1 0.9 1</diffuse><emissive>0.4 0.0 0.4 1</emissive></material></visual>
        <visual name="prop_rl"><pose>-0.20 -0.30 0.035 0 0 0</pose><geometry><mesh><scale>0.15 0.15 0.15</scale><uri>model://x3_uav/meshes/propeller_cw.dae</uri></mesh></geometry><material><ambient>0.0 0.9 1.0 1</ambient><diffuse>0.0 0.9 1.0 1</diffuse></material></visual>
        <visual name="lidar_ring"><pose>0 0 0.068 0 0 0</pose><geometry><cylinder><radius>0.039</radius><length>0.016</length></cylinder></geometry><material><ambient>1.0 0.9 0.0 1</ambient><diffuse>1.0 0.95 0.1 1</diffuse><emissive>0.8 0.75 0.0 1</emissive></material></visual>
        <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>250</update_rate><topic>/uav_epsilon/imu</topic></sensor>
        <sensor name="air_pressure" type="air_pressure"><always_on>1</always_on><update_rate>50</update_rate><topic>/uav_epsilon/air_pressure</topic><air_pressure><reference_altitude>0.0</reference_altitude><pressure><noise type="gaussian"><mean>0.0</mean><stddev>1.2</stddev></noise></pressure></air_pressure></sensor>
        <sensor name="magnetometer" type="magnetometer"><always_on>1</always_on><update_rate>50</update_rate><topic>/uav_epsilon/magnetometer</topic></sensor>
        <sensor name="navsat" type="navsat"><always_on>1</always_on><update_rate>10</update_rate><topic>/uav_epsilon/navsat</topic></sensor>
        <sensor name="lidar" type="gpu_lidar"><pose>0 0 0.1 0 0 0</pose><topic>/uav_epsilon/lidar/points</topic><update_rate>10</update_rate><ray><scan><horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal><vertical><samples>32</samples><resolution>1</resolution><min_angle>-0.436332</min_angle><max_angle>0.261799</max_angle></vertical></scan><range><min>0.1</min><max>50.0</max></range></ray><always_on>1</always_on></sensor>
        <sensor name="rangefinder" type="gpu_lidar"><pose>0 0 -0.04 0 1.5707963 0</pose><topic>/uav_epsilon/rangefinder/distance</topic><update_rate>50</update_rate><ray><scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal><vertical><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan><range><min>0.05</min><max>40.0</max></range></ray><always_on>1</always_on></sensor>
        <sensor name="camera_rgb" type="camera"><pose>0.15 0 0 0 0 0</pose><update_rate>30</update_rate><topic>/uav_epsilon/camera/image_raw</topic><camera><horizontal_fov>1.3962634</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>0.1</near><far>150</far></clip></camera><always_on>1</always_on></sensor>
        <sensor name="camera_thermal" type="thermal"><pose>0.15 0 -0.03 0 0 0</pose><update_rate>30</update_rate><topic>/uav_epsilon/thermal_camera/image_raw</topic><camera><horizontal_fov>1.047</horizontal_fov><image><width>640</width><height>480</height><format>L8</format></image></camera><always_on>1</always_on></sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl"><link_name>base_link</link_name><topic>/uav_epsilon/gazebo/command/twist</topic></plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions></plugin>
