          <geometry><mesh><scale>1.5 1.5 1.5</scale><uri>model://x3_uav/meshes/firefly.dae</uri></mesh></geometry>
          <material>
            <ambient>0.80 0.32 0.00 1</ambient>
            <diffuse>1.00 0.40 0.00 1</diffuse>
          </material>
        </visual>
        <visual name="beacon">
          <pose>0 0 0.1 0 0 0</pose>
          <geometry><sphere><radius>0.08</radius></sphere></geometry>
          <material>
            <ambient>1.0 0.4 0.0 1</ambient>
            <diffuse>1.0 0.4 0.0 1</diffuse>
            <emissive>1.00 0.40 0.00 1</emissive>
          </material>
        </visual>
        <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>200</update_rate><topic>/uav_2/imu</topic></sensor>
        <sensor name="navsat" type="navsat"><always_on>1</always_on><update_rate>10</update_rate><topic>/uav_2/navsat</topic></sensor>
        <sensor name="camera_rgb" type="camera"><pose>0.15 0 -0.05 0 0.4 0</pose><update_rate>30</update_rate><topic>/uav_2/camera/image_raw</topic><camera><horizontal_fov>1.4</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>150</far></clip></camera><always_on>1</always_on></sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>base_link</link_name><topic>/uav_2/gazebo/command/twist</topic>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions></plugin>
