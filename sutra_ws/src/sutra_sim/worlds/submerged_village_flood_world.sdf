    <!-- 🚤 RESCUE BOAT ALPHA (Navigating Flooded Street) -->
    <model name="rescue_boat_alpha">
      <pose>14.0 -12.0 1.65 0 0 0.15</pose>
      <static>false</static>
      <link name="hull">
        <gravity>false</gravity>
        <inertial><mass>200.0</mass><inertia><ixx>10.0</ixx><iyy>25.0</iyy><izz>30.0</izz></inertia></inertial>
        <visual name="hull_vis">
          <geometry><box><size>1.8 4.2 0.8</size></box></geometry>
          <material>
            <ambient>1.0 0.25 0.0 1</ambient>
            <diffuse>1.0 0.25 0.0 1</diffuse>
            <emissive>0.30 0.08 0.00 1</emissive>
          </material>
        </visual>
        <visual name="bow_light">
          <pose>0 1.9 0.4 0 0 0</pose>
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>1 1 0.9 1</ambient><diffuse>1 1 0.9 1</diffuse><emissive>1.00 1.00 0.90 1</emissive></material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>hull</link_name>
        <topic>/rescue_boat_alpha/gazebo/command/twist</topic>
      </plugin>
    </model>


    <!-- ================================================================ -->
    <!-- 👥 SUTRA DISASTER SURVIVORS & VICTIMS (STANDING MAN & SWIMMING GIRL) -->
    <!-- ================================================================ -->

    <!-- 👤 1. STANDING MAN - Mansion Rooftop Command Sector (Pacing / Waving) -->
    <model name="standing_man_mansion">
      <pose>20.5 19.5 4.50 0 0 0</pose>
      <static>false</static>
      <link name="link">
        <gravity>false</gravity>
        <inertial><mass>75.0</mass><inertia><ixx>1.5</ixx><iyy>1.5</iyy><izz>1.5</izz></inertia></inertial>
        <collision name="c"><pose>0 0 0.85 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name="mesh">
          <geometry><mesh><uri>model://standing_man/meshes/standing_man.glb</uri><scale>1.0 1.0 1.0</scale></mesh></geometry>
        </visual>
        <visual name="beacon">
          <pose>0 0 2.2 0 0 0</pose>
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
          <material><ambient>1.0 0.5 0.0 1</ambient><diffuse>1.0 0.5 0.0 1</diffuse><emissive>1.00 0.60 0.00 1</emissive></material>
        </visual>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>link</link_name>
        <topic>/standing_man_mansion/gazebo/command/twist</topic>
