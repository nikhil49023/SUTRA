<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="submerged_village_flood_world">
    
    <!-- ── Physics Engine Settings ─────────────────────────────────────────── -->
    <physics name="500hz_physics" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- Essential Gazebo Sim System Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />

    <!-- ── Atmosphere & Balanced Disaster Lighting ─────────────────────────── -->
    <atmosphere type="adiabatic"/>
    <scene>
      <ambient>0.35 0.38 0.42 1.0</ambient>
      <background>0.45 0.55 0.65 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Primary Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 200 0 0 0</pose>
      <diffuse>0.85 0.85 0.82 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.2 -1.0</direction>
    </light>

    <!-- Fill Light -->
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 150 0 0 0</pose>
      <diffuse>0.4 0.45 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.3 -0.2 -1.0</direction>
    </light>

    <!-- ── Submerged Village Flood World Model (Horizontally Aligned) ───────── -->
    <include>
      <name>submerged_village_disaster</name>
      <uri>model://submerged_village_flood</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- ── 8-UAV Swarm, Rescue Boat, 17 Survivors, & No-Fly Zones ──────────── -->

    <!-- 🚁 UAV_1 — Lead Alpha (Cyan) -->
    <model name="uav_1">
      <pose>18.0 5.0 15.0 0 0 0</pose>
      <static>false</static>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial>
          <mass>1.5</mass>
          <inertia><ixx>0.035</ixx><iyy>0.070</iyy><izz>0.098</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><box><size>0.5 0.5 0.15</size></box></geometry>
        </collision>
        <visual name="body">
          <geometry><mesh><scale>1.5 1.5 1.5</scale><uri>model://x3_uav/meshes/firefly.dae</uri></mesh></geometry>
          <material>
            <ambient>0.00 0.72 0.80 1</ambient>
            <diffuse>0.00 0.90 1.00 1</diffuse>
          </material>
        </visual>
        <visual name="beacon">
          <pose>0 0 0.1 0 0 0</pose>
          <geometry><sphere><radius>0.08</radius></sphere></geometry>
          <material>
            <ambient>0.0 0.9 1.0 1</ambient>
            <diffuse>0.0 0.9 1.0 1</diffuse>
            <emissive>0.00 0.90 1.00 1</emissive>
          </material>
        </visual>
        <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>200</update_rate><topic>/uav_1/imu</topic></sensor>
        <sensor name="navsat" type="navsat"><always_on>1</always_on><update_rate>10</update_rate><topic>/uav_1/navsat</topic></sensor>
        <sensor name="camera_rgb" type="camera"><pose>0.15 0 -0.05 0 0.4 0</pose><update_rate>30</update_rate><topic>/uav_1/camera/image_raw</topic><camera><horizontal_fov>1.4</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>150</far></clip></camera><always_on>1</always_on></sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>base_link</link_name><topic>/uav_1/gazebo/command/twist</topic>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions></plugin>
    </model>

    <!-- 🚁 UAV_2 — West Recon (Orange) -->
    <model name="uav_2">
      <pose>5.0 -10.0 11.0 0 0 0</pose>
      <static>false</static>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial>
          <mass>1.5</mass>
