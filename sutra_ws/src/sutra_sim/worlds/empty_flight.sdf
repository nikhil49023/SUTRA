        <visual name="arm_fl"><pose>0.18 0.18 0 0 0 0.785</pose><geometry><box><size>0.3 0.04 0.04</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual>
