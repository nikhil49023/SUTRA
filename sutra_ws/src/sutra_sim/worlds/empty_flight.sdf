      <static>false</static>
      <link name="base_link">
        <inertial><mass>1.5</mass><inertia><ixx>0.025</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.025</iyy><iyz>0</iyz><izz>0.045</izz></inertia></inertial>
        <collision name="chassis_collision"><geometry><box><size>0.48 0.48 0.12</size></box></geometry></collision>
