    <!-- Waypoint Target Marker 1 (20m North) -->
    <model name="wp_1">
      <static>true</static>
      <pose>20 0 10 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><sphere><radius>0.4</radius></sphere></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 0.8</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Waypoint Target Marker 2 (20m East) -->
    <model name="wp_2">
      <static>true</static>
      <pose>20 20 10 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><sphere><radius>0.4</radius></sphere></geometry>
          <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 0.8</diffuse></material>
        </visual>
      </link>
