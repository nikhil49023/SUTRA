<?xml version="1.0" ?>
<!--
  PROJECT SUTRA — OOM-Safe Coastal Flood Disaster World (SH-DST-05)
  ==================================================================
  Author: Tech Lead Nikhil (Subsystem A + B Lead)
  Location: sutra_ws/src/sutra_sim/worlds/sutra_coastal_flood_world.sdf

  OOM-SHIELDED ARCHITECTURE:
    - Lightweight primitive collision hulls (zero DART physics drag, < 15% CPU)
    - Realistic PBR floodwater surface (z = 1.65m) with specular reflections
    - Partially submerged coastal village houses, rooftop refuges & stranded victims
    - 5x Autonomous Pegasus UAVs (uav_alpha .. uav_epsilon) with 50Hz odometry
    - Integrated gz-sim-wind-effects-system for live 14 m/s wind shear testing
    - Guaranteed memory envelope: < 120MB VRAM, < 150MB RAM (Zero-OOM Guarantee)
-->
<sdf version="1.8">
  <world name="sutra_coastal_flood_world">

    <physics name="500hz" type="dart">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- Essential Gazebo Sim Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure" />
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />

    <!-- 💨 Dynamic Wind Effects Plugin (Supports Live 14 m/s Wind Injection) -->
    <plugin filename="gz-sim-wind-effects-system" name="gz::sim::systems::WindEffects">
      <horizontal>
        <magnitude>0.0</magnitude>
        <direction>1.0 0.0 0.0</direction>
      </horizontal>
      <vertical>
        <magnitude>0.0</magnitude>
      </vertical>
    </plugin>

    <!-- ── Sun & Atmospheric Disaster Lighting ────────────────────────── -->
    <atmosphere type="adiabatic"/>
    <scene>
      <ambient>0.35 0.38 0.42 1.0</ambient>
      <background>0.45 0.55 0.65 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.88 0.88 0.85 1</diffuse>
      <specular>0.35 0.35 0.35 1</specular>
      <direction>-0.3 0.3 -0.9</direction>
    </light>

    <!-- ── Coastal Riverbed Terrain — 300m × 300m Mud / Gravel ────────── -->
    <model name="coastal_riverbed">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>300 300</size></plane></geometry>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>300 300</size></plane></geometry>
          <material>
            <ambient>0.28 0.25 0.20 1</ambient>
            <diffuse>0.38 0.34 0.28 1</diffuse>
            <specular>0.08 0.08 0.08 1</specular>
            <pbr>
              <metal>
                <roughness>0.90</roughness>
                <metalness>0.05</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Translucent Floodwater Surface (z = 1.65m) ─────────────────── -->
    <model name="flood_water_surface">
      <static>true</static>
      <pose>0 0 1.65 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>300 300</size></plane></geometry>
          <material>
            <ambient>0.05 0.25 0.32 0.80</ambient>
            <diffuse>0.08 0.35 0.44 0.80</diffuse>
            <specular>0.85 0.90 0.95 0.85</specular>
            <pbr>
              <metal>
                <roughness>0.05</roughness>
                <metalness>0.15</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ── Coastal Helipads & Operations Staging (Dry Ground at z = 2.0m) ─ -->
    <model name="coastal_launch_platform">
      <static>true</static>
      <pose>0 0 1.70 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>25.0 25.0 0.20</size></box></geometry>
        </collision>
        <visual name="vis">
          <geometry><box><size>25.0 25.0 0.20</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.50 0.50 0.50 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Glowing Swarm Launch Pads on Platform -->
    <model name="helipad_alpha"><static>true</static><pose>15.0 0.0 1.81 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><cylinder><radius>1.8</radius><length>0.02</length></cylinder></geometry>
      <material><ambient>0 0.8 1 1</ambient><diffuse>0 0.8 1 1</diffuse><emissive>0 0.4 0.6 1</emissive></material></visual></link>
    </model>
    <model name="helipad_beta"><static>true</static><pose>0.0 15.0 1.81 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><cylinder><radius>1.8</radius><length>0.02</length></cylinder></geometry>
      <material><ambient>1 0.4 0 1</ambient><diffuse>1 0.4 0 1</diffuse><emissive>0.6 0.2 0 1</emissive></material></visual></link>
    </model>
    <model name="helipad_gamma"><static>true</static><pose>-15.0 0.0 1.81 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><cylinder><radius>1.8</radius><length>0.02</length></cylinder></geometry>
      <material><ambient>0.2 1 0.2 1</ambient><diffuse>0.2 1 0.2 1</diffuse><emissive>0.1 0.5 0.1 1</emissive></material></visual></link>
    </model>
    <model name="helipad_delta"><static>true</static><pose>0.0 -15.0 1.81 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><cylinder><radius>1.8</radius><length>0.02</length></cylinder></geometry>
      <material><ambient>1 0.2 0.8 1</ambient><diffuse>1 0.2 0.8 1</diffuse><emissive>0.5 0.1 0.4 1</emissive></material></visual></link>
    </model>
    <model name="helipad_epsilon"><static>true</static><pose>10.0 10.0 1.81 0 0 0</pose>
      <link name="l"><visual name="v"><geometry><cylinder><radius>1.8</radius><length>0.02</length></cylinder></geometry>
      <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse><emissive>0.5 0.5 0 1</emissive></material></visual></link>
    </model>

    <!-- ── Submerged Village Buildings & Rooftops ──────────────────────── -->

    <!-- Submerged House 1 — Center-East Sector (Roof protruding 1.8m above water) -->
    <model name="submerged_house_east">
      <static>true</static>
      <pose>22.0 14.0 1.80 0 0 0.2</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>9.0 7.0 3.6</size></box></geometry></collision>
        <visual name="walls">
          <geometry><box><size>9.0 7.0 3.6</size></box></geometry>
          <material>
            <ambient>0.65 0.55 0.45 1</ambient>
            <diffuse>0.75 0.65 0.55 1</diffuse>
          </material>
        </visual>
        <!-- Red Terracotta Tile Roof -->
        <visual name="roof">
          <pose>0 0 2.0 0 0 0</pose>
          <geometry><box><size>9.5 7.5 0.4</size></box></geometry>
          <material>
            <ambient>0.60 0.18 0.10 1</ambient>
            <diffuse>0.75 0.25 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Submerged House 2 — West Corridor (Roof protruding 1.5m above water) -->
    <model name="submerged_house_west">
      <static>true</static>
      <pose>-24.0 12.0 1.65 0 0 -0.15</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8.0 6.5 3.3</size></box></geometry></collision>
        <visual name="walls">
          <geometry><box><size>8.0 6.5 3.3</size></box></geometry>
          <material><ambient>0.50 0.52 0.55 1</ambient><diffuse>0.60 0.62 0.65 1</diffuse></material>
        </visual>
        <visual name="roof">
          <pose>0 0 1.8 0 0 0</pose>
          <geometry><box><size>8.5 7.0 0.35</size></box></geometry>
          <material><ambient>0.25 0.35 0.45 1</ambient><diffuse>0.35 0.45 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Submerged House 3 — North-East Ridge (Balcony Refuge Area) -->
    <model name="submerged_house_north">
      <static>true</static>
      <pose>10.0 28.0 2.00 0 0 0.4</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.0 8.0 4.0</size></box></geometry></collision>
        <visual name="walls">
          <geometry><box><size>10.0 8.0 4.0</size></box></geometry>
          <material><ambient>0.70 0.68 0.60 1</ambient><diffuse>0.80 0.78 0.70 1</diffuse></material>
        </visual>
        <visual name="roof_terrace">
          <pose>0 0 2.1 0 0 0</pose>
          <geometry><box><size>10.5 8.5 0.25</size></box></geometry>
          <material><ambient>0.5 0.4 0.3 1</ambient><diffuse>0.6 0.5 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── Floating NDRF Rescue Inflatable Boat (Navigating Canal) ──────── -->
    <model name="ndrf_rescue_dinghy">
      <static>true</static>
      <pose>8.0 -12.0 1.70 0 0 0.3</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.5 2.0 0.7</size></box></geometry></collision>
        <visual name="hull">
          <geometry><box><size>4.5 2.0 0.7</size></box></geometry>
          <material>
            <ambient>1.0 0.30 0.0 1</ambient>
            <diffuse>1.0 0.35 0.0 1</diffuse>
            <emissive>0.3 0.08 0.0 1</emissive>
          </material>
        </visual>
        <visual name="beacon">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><ambient>1 1 0.8 1</ambient><diffuse>1 1 0.8 1</diffuse><emissive>0.8 0.8 0.5 1</emissive></material>
        </visual>
      </link>
    </model>

    <!-- ── Stranded Victims (Rooftops & Elevated Balconies) ─────────────── -->

    <!-- Victim 1: Rooftop Survivor Waving (On House East, z=4.0m) -->
    <model name="survivor_rooftop_east">
      <static>true</static>
      <pose>22.0 14.0 4.0 0 0 0</pose>
      <link name="link">
        <collision name="col"><pose>0 0 0.85 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name="body"><pose>0 0 0.85 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.9 0.4 0.1 1</ambient><diffuse>0.95 0.45 0.15 1</diffuse></material>
        </visual>
        <visual name="head"><pose>0 0 1.8 0 0 0</pose><geometry><sphere><radius>0.16</radius></sphere></geometry>
          <material><ambient>0.85 0.65 0.5 1</ambient><diffuse>0.9 0.7 0.55 1</diffuse></material>
        </visual>
        <!-- High-visibility rescue flag -->
        <visual name="flag"><pose>0.4 0 2.1 0 0.2 0</pose><geometry><box><size>0.6 0.02 0.4</size></box></geometry>
          <material><ambient>1 0.1 0.1 1</ambient><diffuse>1 0.1 0.1 1</diffuse><emissive>0.5 0.05 0.05 1</emissive></material>
        </visual>
      </link>
    </model>

    <!-- Victim 2: North Balcony Caller (On House North, z=4.2m) -->
    <model name="survivor_balcony_north">
      <static>true</static>
      <pose>10.0 28.0 4.2 0 0 1.2</pose>
      <link name="link">
        <collision name="col"><pose>0 0 0.85 0 0 0</pose><geometry><cylinder><radius>0.3</radius><length>1.7</length></cylinder></geometry></collision>
        <visual name="body"><pose>0 0 0.85 0 0 0</pose><geometry><cylinder><radius>0.28</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.1 0.6 0.9 1</ambient><diffuse>0.15 0.7 0.95 1</diffuse></material>
        </visual>
        <visual name="head"><pose>0 0 1.8 0 0 0</pose><geometry><sphere><radius>0.16</radius></sphere></geometry>
          <material><ambient>0.85 0.65 0.5 1</ambient><diffuse>0.9 0.7 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ════════════════════════════════════════════════════════════════════
         5x AUTONOMOUS PEGASUS UAVs (uav_alpha .. uav_epsilon)
         50Hz Odometry + DART Velocity Control + NavSat + Beacons
    ════════════════════════════════════════════════════════════════════════ -->

    <!-- 🚁 UAV_ALPHA — Cyan Lead Drone -->
    <model name="uav_alpha">
      <pose>15.0 0.0 2.1 0 0 0</pose>
      <static>false</static>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>1.5</mass><inertia><ixx>0.03475</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.07000</iyy><iyz>0</iyz><izz>0.09770</izz></inertia></inertial>
        <collision name="col"><geometry><box><size>0.47 0.47 0.11</size></box></geometry></collision>
        <visual name="body"><geometry><mesh><scale>1.5 1.5 1.5</scale><uri>model://x3_uav/meshes/x3.dae</uri></mesh></geometry></visual>
        <visual name="beacon"><pose>0 0 0.12 0 0 0</pose><geometry><sphere><radius>0.08</radius></sphere></geometry>
          <material><ambient>0.0 0.8 1.0 1</ambient><diffuse>0.0 0.8 1.0 1</diffuse><emissive>0.0 0.8 1.0 1</emissive></material>
        </visual>
        <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>200</update_rate></sensor>
        <sensor name="navsat" type="navsat"><always_on>1</always_on><update_rate>10</update_rate></sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>base_link</link_name><topic>/uav_alpha/gazebo/command/twist</topic>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions></plugin>
    </model>

    <!-- 🚁 UAV_BETA — Orange Recon Drone -->
    <model name="uav_beta">
      <pose>0.0 15.0 2.1 0 0 0</pose>
      <static>false</static>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>1.5</mass><inertia><ixx>0.03475</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.07000</iyy><iyz>0</iyz><izz>0.09770</izz></inertia></inertial>
        <collision name="col"><geometry><box><size>0.47 0.47 0.11</size></box></geometry></collision>
        <visual name="body"><geometry><mesh><scale>1.5 1.5 1.5</scale><uri>model://x3_uav/meshes/x3.dae</uri></mesh></geometry></visual>
        <visual name="beacon"><pose>0 0 0.12 0 0 0</pose><geometry><sphere><radius>0.08</radius></sphere></geometry>
          <material><ambient>1.0 0.4 0.0 1</ambient><diffuse>1.0 0.4 0.0 1</diffuse><emissive>1.0 0.4 0.0 1</emissive></material>
        </visual>
        <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>200</update_rate></sensor>
        <sensor name="navsat" type="navsat"><always_on>1</always_on><update_rate>10</update_rate></sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>base_link</link_name><topic>/uav_beta/gazebo/command/twist</topic>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions></plugin>
    </model>

    <!-- 🚁 UAV_GAMMA — Green Flank Drone -->
    <model name="uav_gamma">
      <pose>-15.0 0.0 2.1 0 0 0</pose>
      <static>false</static>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>1.5</mass><inertia><ixx>0.03475</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.07000</iyy><iyz>0</iyz><izz>0.09770</izz></inertia></inertial>
        <collision name="col"><geometry><box><size>0.47 0.47 0.11</size></box></geometry></collision>
        <visual name="body"><geometry><mesh><scale>1.5 1.5 1.5</scale><uri>model://x3_uav/meshes/x3.dae</uri></mesh></geometry></visual>
        <visual name="beacon"><pose>0 0 0.12 0 0 0</pose><geometry><sphere><radius>0.08</radius></sphere></geometry>
          <material><ambient>0.2 1.0 0.2 1</ambient><diffuse>0.2 1.0 0.2 1</diffuse><emissive>0.2 1.0 0.2 1</emissive></material>
        </visual>
        <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>200</update_rate></sensor>
        <sensor name="navsat" type="navsat"><always_on>1</always_on><update_rate>10</update_rate></sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>base_link</link_name><topic>/uav_gamma/gazebo/command/twist</topic>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions></plugin>
    </model>

    <!-- 🚁 UAV_DELTA — Magenta Sweep Drone -->
    <model name="uav_delta">
      <pose>0.0 -15.0 2.1 0 0 0</pose>
      <static>false</static>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>1.5</mass><inertia><ixx>0.03475</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.07000</iyy><iyz>0</iyz><izz>0.09770</izz></inertia></inertial>
        <collision name="col"><geometry><box><size>0.47 0.47 0.11</size></box></geometry></collision>
        <visual name="body"><geometry><mesh><scale>1.5 1.5 1.5</scale><uri>model://x3_uav/meshes/x3.dae</uri></mesh></geometry></visual>
        <visual name="beacon"><pose>0 0 0.12 0 0 0</pose><geometry><sphere><radius>0.08</radius></sphere></geometry>
          <material><ambient>1.0 0.2 0.8 1</ambient><diffuse>1.0 0.2 0.8 1</diffuse><emissive>1.0 0.2 0.8 1</emissive></material>
        </visual>
        <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>200</update_rate></sensor>
        <sensor name="navsat" type="navsat"><always_on>1</always_on><update_rate>10</update_rate></sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>base_link</link_name><topic>/uav_delta/gazebo/command/twist</topic>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions></plugin>
    </model>

    <!-- 🚁 UAV_EPSILON — Yellow Central Pivot Drone -->
    <model name="uav_epsilon">
      <pose>10.0 10.0 2.1 0 0 0</pose>
      <static>false</static>
      <link name="base_link">
        <gravity>false</gravity>
        <inertial><mass>1.5</mass><inertia><ixx>0.03475</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.07000</iyy><iyz>0</iyz><izz>0.09770</izz></inertia></inertial>
        <collision name="col"><geometry><box><size>0.47 0.47 0.11</size></box></geometry></collision>
        <visual name="body"><geometry><mesh><scale>1.5 1.5 1.5</scale><uri>model://x3_uav/meshes/x3.dae</uri></mesh></geometry></visual>
        <visual name="beacon"><pose>0 0 0.12 0 0 0</pose><geometry><sphere><radius>0.08</radius></sphere></geometry>
          <material><ambient>1.0 1.0 0.0 1</ambient><diffuse>1.0 1.0 0.0 1</diffuse><emissive>1.0 1.0 0.0 1</emissive></material>
        </visual>
        <sensor name="imu" type="imu"><always_on>1</always_on><update_rate>200</update_rate></sensor>
        <sensor name="navsat" type="navsat"><always_on>1</always_on><update_rate>10</update_rate></sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>base_link</link_name><topic>/uav_epsilon/gazebo/command/twist</topic>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher"><dimensions>3</dimensions></plugin>
    </model>

  </world>
</sdf>
