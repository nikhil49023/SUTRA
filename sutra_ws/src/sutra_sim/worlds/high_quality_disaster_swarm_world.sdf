<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="sutra_max_quality_pbr_world">

    <!-- 500Hz DART Physics Engine Settings -->
    <physics name="500hz_physics" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- Gazebo Sim 8 System Plugins (Sensors, Physics, Scene Broadcaster) -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- WGS84 Spherical Coordinates (San Francisco Disaster Twin) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>37.774929</latitude_deg>
      <longitude_deg>-122.419416</longitude_deg>
      <elevation>15.0</elevation>
    </spherical_coordinates>

    <!-- LAYER 2: Sun Directional Lighting with PSSM 4-Split Shadows -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>50 50 120 0 0 0</pose>
      <diffuse>0.95 0.92 0.88 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Ambient Sky & Fill Lighting -->
    <scene>
      <ambient>0.4 0.45 0.5 1.0</ambient>
      <background>0.6 0.7 0.85 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- LAYER 3: PBR Ground Terrain with Heightmap Elevation -->
    <model name="pbr_disaster_terrain">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <!-- LAYER 1: Ogre2 HLMS PBR Material Properties -->
          <material>
            <ambient>0.3 0.35 0.25 1</ambient>
            <diffuse>0.45 0.5 0.35 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <pbr>
              <metal>
                <roughness>0.8</roughness>
                <metalness>0.1</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- LAYER 3: Collapsed Concrete Building Ruin (Structure 1) -->
    <model name="collapsed_building_ruin_1">
      <static>true</static>
      <pose>25 15 3.0 0.1 0.15 0.6</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>20 14 6</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>20 14 6</size></box>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.6 0.6 0.62 1</diffuse>
            <pbr>
              <metal>
                <roughness>0.9</roughness>
                <metalness>0.05</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- LAYER 3: Debris Field (Concrete Cracks & Steel Reinforcement) -->
    <model name="concrete_debris_field">
      <static>true</static>
      <pose>-30 35 2.0 -0.1 0.2 1.1</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>26 18 4</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>26 18 4</size></box>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <pbr>
              <metal>
                <roughness>0.95</roughness>
                <metalness>0.15</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- LAYER 3 & 5: Survivor Target with Thermal IR Heat Signature -->
    <model name="survivor_target_thermal">
      <static>true</static>
      <pose>28 17 0.8 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <capsule>
              <radius>0.4</radius>
              <length>1.7</length>
            </capsule>
          </geometry>
          <material>
            <ambient>0.9 0.1 0.1 1</ambient>
            <diffuse>1.0 0.2 0.2 1</diffuse>
            <pbr>
              <metal>
                <roughness>0.5</roughness>
                <metalness>0.0</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================= -->
    <!--          SWARM DRONE WITH MULTI-SENSOR STACK (LAYER 5)            -->
    <!-- ================================================================= -->

    <model name="uav_alpha_lead">
      <pose>0 0 15 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>1.50</mass>
          <inertia>
            <ixx>0.025</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.025</iyy><iyz>0</iyz>
            <izz>0.045</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box><size>0.50 0.50 0.18</size></box>
          </geometry>
          <!-- PBR Metallic Quadrotor Frame Material -->
          <material>
            <ambient>0.1 0.2 0.4 1</ambient>
            <diffuse>0.2 0.4 0.8 1</diffuse>
            <pbr>
              <metal>
                <roughness>0.3</roughness>
                <metalness>0.8</metalness>
              </metal>
            </pbr>
          </material>
        </visual>

        <!-- LAYER 5: 200Hz VIO IMU Sensor Plugin -->
        <sensor name="imu_sensor" type="imu">
          <always_on>1</always_on>
          <update_rate>200</update_rate>
          <topic>/uav_alpha/imu</topic>
        </sensor>

        <!-- LAYER 5: Optical RGB Camera Sensor (1080p @ 30Hz) -->
        <sensor name="rgb_camera" type="camera">
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <topic>/uav_alpha/rgb_camera/image_raw</topic>
          <camera>
            <horizontal_fov>1.4</horizontal_fov>
            <image>
              <width>1920</width>
              <height>1080</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>300.0</far>
            </clip>
          </camera>
        </sensor>

        <!-- LAYER 5: Native Thermal LWIR Camera Sensor (640x480 @ 30Hz) -->
        <sensor name="thermal_camera" type="thermal">
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <topic>/uav_alpha/thermal_camera/image_raw</topic>
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>L8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>200.0</far>
            </clip>
          </camera>
        </sensor>

        <!-- LAYER 5: GPU 3D LiDAR Raycast Sensor (16 channels) -->
        <sensor name="gpu_lidar" type="gpu_lidar">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <topic>/uav_alpha/lidar/points</topic>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>16</samples>
                <resolution>1</resolution>
                <min_angle>-0.261799</min_angle>
                <max_angle>0.261799</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.2</min>
              <max>50.0</max>
            </range>
          </lidar>
        </sensor>

      </link>
    </model>

    <!-- Additional Swarm Drones: UAV Beta (Relay Node) -->
    <model name="uav_beta_relay">
      <pose>25 25 18 0 0 0</pose>
      <link name="base_link">
        <inertial>
          <mass>1.50</mass>
          <inertia>
            <ixx>0.025</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.025</iyy><iyz>0</iyz>
            <izz>0.045</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry>
            <box><size>0.50 0.50 0.18</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.6 0.2 1</ambient>
            <diffuse>0.2 0.8 0.4 1</diffuse>
            <pbr>
              <metal>
                <roughness>0.3</roughness>
                <metalness>0.8</metalness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
