<?xml version="1.0" ?>
<!--
Project SUTRA — Stress Scenario 2: Severe GPS Dropout / Denial & VIO Failover
Feature-Rich Canyon Environment for Visual-Inertial Odometry EKF2 Tracking.
-->
<sdf version="1.8">
  <world name="stress_gps_denied_canyon">
    
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Essential Gazebo Sim Systems -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

    <!-- Directional Sun Light -->
    <light type="directional" name="canyon_sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0.8 0.2</pose>
      <diffuse>0.85 0.8 0.7 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <!-- Visual Feature Walls (Left & Right Canyon Walls for VIO Tracking) -->
    <model name="canyon_left_wall">
      <static>true</static>
      <pose>0 15 10 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>200 4 20</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>200 4 20</size></box></geometry>
          <material><ambient>0.5 0.35 0.25 1</ambient><diffuse>0.6 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="canyon_right_wall">
      <static>true</static>
      <pose>0 -15 10 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>200 4 20</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>200 4 20</size></box></geometry>
          <material><ambient>0.5 0.35 0.25 1</ambient><diffuse>0.6 0.4 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- OpenRobotics X3 Quadcopter with Monocular Stereo Camera & IMU -->
    <model name="uav_alpha">
      <pose>0 0 1.5 0 0 0</pose>
      <include><uri>model://x3_uav</uri></include>
      <link name="base_link">
        <sensor name="uav_alpha_lidar" type="gpu_lidar">
          <pose>0 0 0.1 0 0 0</pose>
          <topic>/uav_alpha/lidar/points</topic>
          <update_rate>10</update_rate>
          <ray>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
              <vertical>
                <samples>16</samples>
                <resolution>1</resolution>
                <min_angle>-0.261799</min_angle>
                <max_angle>0.261799</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.1</min>
              <max>30.0</max>
            </range>
          </ray>
          <always_on>1</always_on>
        </sensor>

        <sensor name="uav_alpha_thermal" type="thermal">
          <pose>0.1 0 0 0 0 0</pose>
          <topic>/uav_alpha/thermal/image_raw</topic>
          <update_rate>15</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>640</width><height>480</height><format>L8</format></image>
            <clip><near>0.1</near><far>100</far></clip>
          </camera>
          <always_on>1</always_on>
        </sensor>

        <sensor name="uav_alpha_camera" type="camera">
          <pose>0.15 0 0 0 0 0</pose>
          <topic>/uav_alpha/camera/image_raw</topic>
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.3962634</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>100</far></clip>
          </camera>
          <always_on>1</always_on>
        </sensor>
      </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <link_name>base_link</link_name>
        <topic>/uav_alpha/gazebo/command/twist</topic>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_frame>world</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
      </plugin>
    </model>

  </world>
</sdf>
