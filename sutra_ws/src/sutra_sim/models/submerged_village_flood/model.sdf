<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="submerged_village_flood">
    <static>true</static>
    <link name="link">
      <!-- 90 deg rotation around X to convert Blender Y-up to Gazebo Z-up horizontal ground -->
      <!-- -37.8m Z offset sets the flood water surface perfectly at Z = 0.0m -->
      <pose>0 0 -37.8 1.57079632679 0 0</pose>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://submerged_village_flood/meshes/submerged_village.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://submerged_village_flood/meshes/submerged_village.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
