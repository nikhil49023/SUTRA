<?xml version="1.0"?>
<sdf version="1.8">
  <model name="standing_man">
    <static>false</static>
    <link name="link">
      <gravity>false</gravity>
      <inertial><mass>75.0</mass><inertia><ixx>1.5</ixx><iyy>1.5</iyy><izz>1.5</izz></inertia></inertial>
      <collision name="collision">
        <pose>0 0 0.85 0 0 0</pose>
        <geometry><cylinder><radius>0.3</radius><length>1.7</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://standing_man/meshes/standing_man.glb</uri>
            <scale>1.0 1.0 1.0</scale>
          </mesh>
        </geometry>
      </visual>
      <visual name="beacon">
        <pose>0 0 2.2 0 0 0</pose>
        <geometry><sphere><radius>0.15</radius></sphere></geometry>
        <material>
          <ambient>1.0 0.4 0.0 1</ambient>
          <diffuse>1.0 0.4 0.0 1</diffuse>
          <emissive>1.00 0.50 0.00 1</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>