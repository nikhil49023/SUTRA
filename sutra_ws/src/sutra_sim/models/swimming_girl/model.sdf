<?xml version="1.0"?>
<sdf version="1.8">
  <model name="swimming_girl">
    <static>false</static>
    <link name="link">
      <gravity>false</gravity>
      <inertial><mass>60.0</mass><inertia><ixx>1.2</ixx><iyy>1.2</iyy><izz>1.2</izz></inertia></inertial>
      <collision name="collision">
        <pose>0 0 0.2 0 0 0</pose>
        <geometry><cylinder><radius>0.4</radius><length>0.8</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://swimming_girl/meshes/swimming_girl.glb</uri>
            <scale>1.0 1.0 1.0</scale>
          </mesh>
        </geometry>
      </visual>
      <visual name="beacon">
        <pose>0 0 1.2 0 0 0</pose>
        <geometry><sphere><radius>0.12</radius></sphere></geometry>
        <material>
          <ambient>1.0 0.05 0.05 1</ambient>
          <diffuse>1.0 0.05 0.05 1</diffuse>
          <emissive>1.00 0.10 0.10 1</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>