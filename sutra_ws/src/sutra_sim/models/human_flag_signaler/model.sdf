<?xml version="1.0"?>
<sdf version="1.8">
  <model name="human_flag_signaler">
    <static>false</static>
    <link name="link">
      <gravity>false</gravity>
      <inertial>
        <mass>75.0</mass>
        <inertia>
          <ixx>1.5</ixx><iyy>1.5</iyy><izz>1.5</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.9 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.3</radius>
            <length>1.8</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="human_visual">
        <geometry>
          <mesh>
            <uri>model://human_flag_signaler/meshes/human_flag.obj</uri>
            <scale>1.0 1.0 1.0</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.80 0.80 0.10 1.0</ambient>
          <diffuse>0.95 0.95 0.10 1.0</diffuse>
          <emissive>0.30 0.30 0.05 1.0</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
