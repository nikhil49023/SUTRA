            <!-- 3. Dual Optical RGB + FLIR Thermal Gimbal -->
            <visual name="X3/gimbal_bracket"><pose>0.11 0 -0.022 0 0.15 0</pose><geometry><box><size>0.028 0.045 0.024</size></box></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material></visual>
