<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="uav_beta_relay">
    <pose>0 0 0.2 0 0 0</pose>
    <static>false</static>
    <self_collide>false</self_collide>

    <!-- Main Chassis Frame -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>1.45</mass>
        <inertia>
          <ixx>0.02</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.02</iyy>
          <iyz>0</iyz>
          <izz>0.04</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry>
          <box><size>0.45 0.45 0.15</size></box>
        </geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry>
          <box><size>0.45 0.45 0.15</size></box>
        </geometry>
        <material>
          <ambient>0.1 1.0 0.4 1</ambient>
          <diffuse>0.2 1.0 0.5 1</diffuse>
        </material>
      </visual>

      <!-- IMU Sensor Plugin -->
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>200.0</update_rate>
        <topic>/uav_beta/imu</topic>
      </sensor>

      <!-- RGB Optical Camera Sensor -->
      <sensor name="rgb_camera" type="camera">
        <pose>0.2 0 0.05 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <topic>/uav_beta/rgb_camera/image_raw</topic>
      </sensor>
    </link>
  </model>
</sdf>
