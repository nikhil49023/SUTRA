<?xml version="1.0" ?>
<!--
  PROJECT SUTRA — UAV Beta (Relay & Reconnaissance Quadcopter)
  =============================================================
  Author: Tech Lead Nikhil (Subsystem A + B Lead)
  Location: sutra_ws/src/sutra_sim/models/uav_beta_relay.sdf
-->
<sdf version="1.8">
  <model name="uav_beta_relay">
    <pose>0 0 0.2 0 0 0</pose>
    <static>false</static>
    <self_collide>false</self_collide>

    <!-- Main Chassis Frame -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>1.45</mass>
        <inertia>
          <ixx>0.02</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.02</iyy>
          <iyz>0</iyz>
          <izz>0.04</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry>
          <box><size>0.45 0.45 0.15</size></box>
        </geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry>
          <box><size>0.45 0.45 0.15</size></box>
        </geometry>
        <material>
          <ambient>0.1 1.0 0.4 1</ambient>
          <diffuse>0.2 1.0 0.5 1</diffuse>
        </material>
      </visual>

      <!-- 1. IMU Sensor -->
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>250.0</update_rate>
        <topic>/uav_beta/imu</topic>
      </sensor>

      <!-- 2. Barometer -->
      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>true</always_on>
        <update_rate>50.0</update_rate>
        <topic>/uav_beta/air_pressure</topic>
        <air_pressure><reference_altitude>0.0</reference_altitude><pressure><noise type="gaussian"><mean>0.0</mean><stddev>1.2</stddev></noise></pressure></air_pressure>
      </sensor>

      <!-- 3. Magnetometer -->
      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>true</always_on>
        <update_rate>50.0</update_rate>
        <topic>/uav_beta/magnetometer</topic>
      </sensor>

      <!-- 4. NavSat GNSS -->
      <sensor name="navsat_sensor" type="navsat">
        <always_on>true</always_on>
        <update_rate>10.0</update_rate>
        <topic>/uav_beta/navsat</topic>
      </sensor>

      <!-- 5. 360° 3D GPU LiDAR -->
      <sensor name="lidar_sensor" type="gpu_lidar">
        <pose>0 0 0.08 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10.0</update_rate>
        <topic>/uav_beta/lidar/points</topic>
        <ray>
          <scan>
            <horizontal><samples>720</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal>
            <vertical><samples>32</samples><resolution>1</resolution><min_angle>-0.436332</min_angle><max_angle>0.261799</max_angle></vertical>
          </scan>
          <range><min>0.10</min><max>50.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </ray>
      </sensor>

      <!-- 6. Downward Rangefinder -->
      <sensor name="rangefinder_sensor" type="gpu_lidar">
        <pose>0 0 -0.04 0 1.5707963 0</pose>
        <always_on>true</always_on>
        <update_rate>50.0</update_rate>
        <topic>/uav_beta/rangefinder/distance</topic>
        <ray>
          <scan><horizontal><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></horizontal><vertical><samples>1</samples><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan>
          <range><min>0.05</min><max>40.0</max></range>
        </ray>
      </sensor>

      <!-- 7. Optical RGB Camera -->
      <sensor name="rgb_camera" type="camera">
        <pose>0.2 0 0.05 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <topic>/uav_beta/rgb_camera/image_raw</topic>
        <camera><horizontal_fov>1.4</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>0.1</near><far>200.0</far></clip></camera>
      </sensor>

      <!-- 8. Thermal Camera -->
      <sensor name="thermal_camera" type="thermal">
        <pose>0.2 0 -0.05 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <topic>/uav_beta/thermal_camera/image_raw</topic>
      </sensor>
    </link>
  </model>
</sdf>
