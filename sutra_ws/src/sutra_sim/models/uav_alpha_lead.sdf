<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="uav_alpha_lead">
    <pose>0 0 0.2 0 0 0</pose>
    <static>false</static>
    <self_collide>false</self_collide>

    <!-- Main Chassis Frame -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>1.50</mass>
        <inertia>
          <ixx>0.025</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.025</iyy>
          <iyz>0</iyz>
          <izz>0.045</izz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry>
          <box><size>0.48 0.48 0.16</size></box>
        </geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry>
          <box><size>0.48 0.48 0.16</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.6 1.0 1</ambient>
          <diffuse>0.2 0.7 1.0 1</diffuse>
        </material>
      </visual>

      <!-- IMU Sensor Plugin for VIO & Flight Dynamics -->
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>200.0</update_rate>
        <topic>/uav_alpha/imu</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><stddev>0.01</stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.01</stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.01</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- RGB Optical Camera Sensor -->
      <sensor name="rgb_camera" type="camera">
        <pose>0.2 0 0.05 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <topic>/uav_alpha/rgb_camera/image_raw</topic>
        <camera>
          <horizontal_fov>1.4</horizontal_fov>
          <image>
            <width>1920</width>
            <height>1080</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>300.0</far>
          </clip>
        </camera>
      </sensor>

      <!-- Depth Sensor PointCloud Camera -->
      <sensor name="depth_camera" type="depth_camera">
        <pose>0.2 0 0.02 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>15.0</update_rate>
        <topic>/uav_alpha/depth_camera/points</topic>
        <camera>
          <horizontal_fov>1.5</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R32F</format>
          </image>
          <clip>
            <near>0.25</near>
            <far>10.0</far>
          </clip>
        </camera>
      </sensor>

      <!-- LWIR Thermal Infrared Camera Sensor -->
      <sensor name="thermal_camera" type="thermal">
        <pose>0.2 0 -0.05 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>30.0</update_rate>
        <topic>/uav_alpha/thermal_camera/image_raw</topic>
      </sensor>

    </link>
  </model>
</sdf>
