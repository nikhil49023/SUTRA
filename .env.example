# SUTRA Environment Variables Configuration File
# Copy to .env for local machine configuration (do not commit secrets)

# ROS 2 Domain ID (Isolates network telemetry traffic per team)
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Subsystem D: Mapbox GL JS / Tile Provider Tokens
VITE_MAP_PROVIDER_KEY=
VITE_MAPBOX_TOKEN=pk.eyJ1Ijoic3V0cmEiLCJhIjoiY2x4eHh4eHh4eHh4eHh4eHh4eHh4eHh4In0.example
VITE_MAPTILER_KEY=

# Backend WebSocket Gateway URL (defaults to ws://localhost:8765)
VITE_WS_URL=ws://localhost:8765

# PX4 Autopilot Offboard Bridge Connection
PX4_SIM_HOST=127.0.0.1
PX4_SIM_PORT=8888

# Gazebo Sim 8 Physics Engine Settings
GZ_SIM_RESOURCE_PATH=./sutra_ws/src/sutra_sim/models:./sutra_ws/src/sutra_sim/worlds
