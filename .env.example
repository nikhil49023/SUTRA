# SMART HORIZON GCS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure for deployment. Never commit .env to source control!

GCS_ENV=DEVELOPMENT
GCS_WS_HOST=0.0.0.0
GCS_WS_PORT=8765
GCS_WS_AUTH_REQUIRED=false
GCS_SESSION_TIMEOUT_SEC=3600
GCS_TOKEN_EXPIRY_SEC=86400
GCS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Security Secrets (Generate using openssl rand -hex 32)
GCS_SECRET_KEY=replace-with-a-secure-random-32-byte-hex-key
GCS_JWT_SECRET=replace-with-a-secure-jwt-signing-secret

# Admin Initial Provisioning (Optional bootstrap credentials)
GCS_ADMIN_INITIAL_PASSWORD=replace-with-strong-initial-password
