# SMART HORIZON GCS — Environment Configuration Template
# Copy to .env for custom local credentials (do not commit secrets)

# Optional Custom Map Provider API Keys (Default uses Esri World Imagery & OpenStreetMap without API keys)
VITE_MAP_PROVIDER_KEY=
VITE_MAPBOX_TOKEN=
VITE_MAPTILER_KEY=

# Backend WebSocket Gateway URL (defaults to ws://localhost:8765)
VITE_WS_URL=ws://localhost:8765
