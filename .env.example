# SMART HORIZON GCS — Environment Variables Configuration Template
# Copy this file to .env and set secure values for production deployment.

GCS_ENV=production
GCS_APP_VERSION=1.0.0
GCS_PROTOCOL_VERSION=1.0

# Server Network Bindings
GCS_BACKEND_HOST=0.0.0.0
GCS_BACKEND_PORT=8000
GCS_WEBSOCKET_HOST=0.0.0.0
GCS_WEBSOCKET_PORT=8765
GCS_ALLOWED_ORIGINS=https://gcs.smarthorizon.io,https://tactical.smarthorizon.internal

# Cryptographic Secrets (MUST be securely generated in production)
GCS_TOKEN_SECRET=CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS_TOKEN_SECRET
GCS_JWT_SECRET=CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS_JWT_SECRET
GCS_ADMIN_DEFAULT_PASSWORD=CHANGE_ME_SECURE_ADMIN_PASSWORD_2026!

# Hardware & MAVLink Telemetry Gateway
GCS_SIMULATION_MODE=false
GCS_HARDWARE_MODE=true
GCS_MAVLINK_URI=udp:0.0.0.0:14550
GCS_MAVLINK_BAUD=57600

# Storage & Logging
GCS_STORAGE_DIR=/var/lib/smart-horizon
GCS_LOG_DIR=/var/log/smart-horizon
GCS_LOG_LEVEL=INFO
